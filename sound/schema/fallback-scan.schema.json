{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/blob/main/sound/schema/fallback-scan.schema.json",
  "title": "Fallback bank scan record",
  "description": "One bank scan for an atom with no eligible candidate after 12 slots (av_sound.scan_fallback, ScanResult.to_dict(); Study A protocol §3.7). It is recorded apart from the 12 generated slots. log lists every bank recipe looked at, in index order, up to and including the selected one (all 64 when the outcome is exhausted). outcome 'exhausted' means the complete fallback book replaces the book, which is flagged failed_generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scan_version",
    "profile",
    "bank_sha256",
    "bank_threshold",
    "threshold",
    "reserved_sha256",
    "validator_version",
    "renderer_version",
    "reference_ids",
    "references_sha256",
    "used",
    "outcome",
    "selected_index",
    "selected_source",
    "selected_recipe_sha256",
    "selected_pcm_sha256",
    "log"
  ],
  "properties": {
    "scan_version": { "const": 1 },
    "profile": { "enum": ["P1", "P2", "P3"] },
    "bank_sha256": { "$ref": "#/$defs/sha256" },
    "bank_threshold": {
      "description": "Threshold the bank was built with.",
      "$ref": "#/$defs/threshold"
    },
    "threshold": {
      "description": "Threshold of the book's checks used by this scan.",
      "$ref": "#/$defs/threshold"
    },
    "reserved_sha256": { "$ref": "#/$defs/sha256" },
    "validator_version": { "$ref": "#/$defs/version" },
    "renderer_version": { "$ref": "#/$defs/version" },
    "reference_ids": {
      "description": "IDs of the book's committed references, in commit order.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "references_sha256": {
      "description": "SHA-256 of the compact canonical JSON [[ref_id, recipe_sha256, pcm_sha256], ...].",
      "$ref": "#/$defs/sha256"
    },
    "used": {
      "description": "Bank indices skipped because they were already used in this book.",
      "type": "array",
      "items": { "$ref": "#/$defs/index" }
    },
    "outcome": { "enum": ["selected", "exhausted"] },
    "selected_index": { "oneOf": [{ "$ref": "#/$defs/index" }, { "type": "null" }] },
    "selected_source": {
      "description": "Store source for the commit, e.g. fallback-bank-P1-07.",
      "oneOf": [
        { "type": "string", "pattern": "^fallback-bank-P[1-3]-[0-9]{2}$" },
        { "type": "null" }
      ]
    },
    "selected_recipe_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "selected_pcm_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "log": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "threshold": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$|^[0-9]+/[0-9]+$" },
    "index": { "type": "integer", "minimum": 0, "maximum": 63 },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "recipe_sha256", "pcm_sha256", "outcome", "codes", "messages"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "recipe_sha256": { "$ref": "#/$defs/sha256" },
        "pcm_sha256": { "$ref": "#/$defs/sha256" },
        "outcome": {
          "description": "used: skipped without a check; rejected: failed the book's checks (codes); selected: the first passing recipe.",
          "enum": ["used", "rejected", "selected"]
        },
        "codes": {
          "description": "Validator reason codes in REASON_CODES order; empty for used and selected.",
          "type": "array",
          "items": {
            "enum": [
              "E_JSON",
              "E_SCHEMA",
              "E_DOMAIN",
              "E_EVENT_SHORT",
              "E_NONFINITE",
              "E_CLIP",
              "E_DUPLICATE",
              "E_RESERVED",
              "E_SEPARATION"
            ]
          }
        },
        "messages": {
          "description": "One validator message per code.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
