{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/blob/main/sound/schema/package.schema.json",
  "title": "Learner (Study A) and dyad (Study B) package: manifest.json",
  "description": "Package format 1 (av_sound.package, #13; contract in docs/interfaces/package-format.md). The root schema is manifest.json; $defs/answers, $defs/audio and $defs/allocation describe answers.json, audio.json and allocation.json. permutation.json (#29) and schedules/<person_id>/<visit>.json (#30) keep their own formats. Variants: study A (one book: 16 atom WAVs, 18 trained-message WAVs) and study B (one dyad bank: 16 atoms x 3 profiles x 4 options, no message WAVs). Held-out messages never have a file. files lists every file of the package except manifest.json with its SHA-256 and size; a package directory holds exactly these files. package_sha256 is the SHA-256 of the compact canonical JSON (keys sorted by code point, separators ',' and ':', ASCII) of the manifest without the package_sha256 field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "study",
    "package_id",
    "demo",
    "builder",
    "renderer_version",
    "composition_contract",
    "files",
    "package_sha256"
  ],
  "properties": {
    "format": { "const": "av-sound/package" },
    "format_version": { "const": 1 },
    "study": { "enum": ["A", "B"] },
    "package_id": { "$ref": "#/$defs/package_id" },
    "demo": {
      "description": "True for a synthetic DEMO package (package_id starts with DEMO-). DEMO packages must never be used with participants.",
      "type": "boolean"
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "av-sound" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "renderer_version": { "$ref": "#/$defs/version" },
    "composition_contract": {
      "description": "Version of the message byte contract (sound/docs/composition.md).",
      "$ref": "#/$defs/version"
    },
    "profile": {
      "description": "Study A: the book's profile.",
      "$ref": "#/$defs/profile"
    },
    "book": {
      "description": "Study A: the frozen store book the package was built from (sound/docs/store.md). frozen_head is the chain head of the book's freeze record (the SHA-256 of that log line, the value freeze() returns); snapshot_sha256 is snapshot_digest({atom_id: pcm_sha256}); renderer_hash and validator_hash are the code hashes the book records.",
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_head", "snapshot_sha256", "renderer_hash", "validator_hash"],
      "properties": {
        "frozen_head": { "$ref": "#/$defs/sha256" },
        "renderer_hash": { "$ref": "#/$defs/sha256" },
        "validator_hash": { "$ref": "#/$defs/sha256" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bank": {
      "description": "Study B: the frozen dyad bank the package was built from (PROVISIONAL input format until #26).",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "bank_sha256"],
      "properties": {
        "format": { "const": "av-sound/provisional-bank" },
        "format_version": { "const": 1 },
        "bank_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "description": "Every file of the package except manifest.json: relative POSIX path -> SHA-256 and size of the file bytes.",
      "type": "object",
      "required": ["answers.json", "audio.json"],
      "propertyNames": {
        "anyOf": [{ "$ref": "#/$defs/path_a" }, { "$ref": "#/$defs/path_b" }]
      },
      "additionalProperties": { "$ref": "#/$defs/file_entry" }
    },
    "package_sha256": { "$ref": "#/$defs/sha256" }
  },
  "oneOf": [
    {
      "properties": {
        "study": { "const": "A" },
        "files": { "propertyNames": { "$ref": "#/$defs/path_a" } }
      },
      "required": ["profile", "book"],
      "not": { "anyOf": [{ "required": ["bank"] }] }
    },
    {
      "properties": {
        "study": { "const": "B" },
        "files": { "propertyNames": { "$ref": "#/$defs/path_b" } }
      },
      "required": ["bank"],
      "not": { "anyOf": [{ "required": ["profile"] }, { "required": ["book"] }] }
    }
  ],
  "allOf": [{ "$ref": "#/$defs/demo_rule" }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profile": { "enum": ["P1", "P2", "P3"] },
    "family": { "enum": ["K", "Q"] },
    "index": { "type": "integer", "minimum": 1, "maximum": 4 },
    "wave": { "type": "integer", "minimum": 1, "maximum": 3 },
    "atom_id": { "type": "string", "pattern": "^[KQ]-[ar][1-4]$" },
    "message_id": { "type": "string", "pattern": "^[KQ]-a[1-4]-r[1-4]$" },
    "heldout_set": { "enum": ["H-V1", "H-V2", "H-V3", "H-W1", "H-W4"] },
    "atom_samples": { "enum": [21600, 28800, 36000, 43200] },
    "message_samples": { "type": "integer", "minimum": 52800, "maximum": 96000 },
    "message_ms": { "enum": [1100, 1250, 1400, 1550, 1700, 1850, 2000] },
    "label": {
      "enum": ["ADD_ONE", "REMOVE_ONE", "FLIP_CARD", "ALIGN_ARROW", "A", "B", "C", "D", "SCAN", "TAG", "CLOSE", "QUARANTINE", "E", "F", "G", "H"]
    },
    "package_id": {
      "description": "Anonymous ID: the store book ID (A) or the bank ID (B). No method label, designer ID or candidate history.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,62}[A-Za-z0-9]$"
    },
    "demo_rule": {
      "if": { "properties": { "demo": { "const": true } }, "required": ["demo"] },
      "then": { "properties": { "package_id": { "pattern": "^DEMO-" } } },
      "else": { "properties": { "package_id": { "not": { "pattern": "^DEMO-" } } } }
    },
    "path_a": {
      "description": "Study A files. messages/ holds only the 18 trained message IDs of the fixed matrix.",
      "type": "string",
      "pattern": "^(answers\\.json|audio\\.json|permutation\\.json|allocation\\.json|atoms/[KQ]-[ar][1-4]\\.wav|messages/[KQ]-a(1-r1|1-r3|2-r2|2-r4|3-r1|3-r3|3-r4|4-r2|4-r3)\\.wav|schedules/A-[PC][0-9]{2}-L[0-9]{2}/D[07]\\.json)$"
    },
    "path_b": {
      "description": "Study B files: option WAVs options/<profile>/<atom_id>-<rank>.wav; no message WAVs.",
      "type": "string",
      "pattern": "^(answers\\.json|audio\\.json|permutation\\.json|allocation\\.json|options/P[123]/[KQ]-[ar][1-4]-[1-4]\\.wav|schedules/B-[PCS][0-9]{2}-M[12]/(V[123]|W[14])\\.json)$"
    },
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "answers": {
      "title": "answers.json: hidden-answer manifest",
      "description": "HIDDEN-ANSWER MATERIAL for the trusted task queue (#67): the meaning bound to every atom and the intended action and referent of every message. Never shown to a participant or a masked operator.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "study",
        "package_id",
        "demo",
        "hidden_answer",
        "atoms",
        "messages",
        "trained_message_ids",
        "heldout_message_ids",
        "heldout_sets"
      ],
      "properties": {
        "format": { "const": "av-sound/package-answers" },
        "format_version": { "const": 1 },
        "study": { "enum": ["A", "B"] },
        "package_id": { "$ref": "#/$defs/package_id" },
        "demo": { "type": "boolean" },
        "hidden_answer": { "const": true },
        "atoms": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atom_id", "family", "role", "index", "semantic_label", "wave"],
            "properties": {
              "atom_id": { "$ref": "#/$defs/atom_id" },
              "family": { "$ref": "#/$defs/family" },
              "role": { "enum": ["action", "referent"] },
              "index": { "$ref": "#/$defs/index" },
              "semantic_label": { "$ref": "#/$defs/label" },
              "wave": {
                "description": "Wave that introduces the atom in Study B (V1: a1, a2, r1, r2; V2: a3, r3; V3: a4, r4).",
                "$ref": "#/$defs/wave"
              }
            }
          }
        },
        "messages": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_id",
              "family",
              "action_atom",
              "referent_atom",
              "action_index",
              "referent_index",
              "semantic_action",
              "semantic_referent",
              "status",
              "training_wave",
              "heldout_set"
            ],
            "properties": {
              "message_id": { "$ref": "#/$defs/message_id" },
              "family": { "$ref": "#/$defs/family" },
              "action_atom": { "type": "string", "pattern": "^[KQ]-a[1-4]$" },
              "referent_atom": { "type": "string", "pattern": "^[KQ]-r[1-4]$" },
              "action_index": { "$ref": "#/$defs/index" },
              "referent_index": { "$ref": "#/$defs/index" },
              "semantic_action": { "enum": ["ADD_ONE", "REMOVE_ONE", "FLIP_CARD", "ALIGN_ARROW", "SCAN", "TAG", "CLOSE", "QUARANTINE"] },
              "semantic_referent": { "enum": ["A", "B", "C", "D", "E", "F", "G", "H"] },
              "status": { "enum": ["trained", "heldout"] },
              "training_wave": { "oneOf": [{ "$ref": "#/$defs/wave" }, { "type": "null" }] },
              "heldout_set": { "oneOf": [{ "$ref": "#/$defs/heldout_set" }, { "type": "null" }] }
            },
            "if": { "properties": { "status": { "const": "trained" } } },
            "then": { "properties": { "training_wave": { "type": "integer" }, "heldout_set": { "type": "null" } } },
            "else": { "properties": { "training_wave": { "type": "null" }, "heldout_set": { "type": "string" } } }
          }
        },
        "trained_message_ids": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/message_id" }
        },
        "heldout_message_ids": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/message_id" }
        },
        "heldout_sets": {
          "description": "Abstract held-out sets of the fixed matrix. Which set is tested at which visit depends on the H-W1/H-W4 swap and is added at sealing (allocation.json).",
          "type": "object",
          "additionalProperties": false,
          "required": ["H-V1", "H-V2", "H-V3", "H-W1", "H-W4"],
          "properties": {
            "H-V1": { "$ref": "#/$defs/message_set" },
            "H-V2": { "$ref": "#/$defs/message_set" },
            "H-V3": { "$ref": "#/$defs/message_set" },
            "H-W1": { "$ref": "#/$defs/message_set" },
            "H-W4": { "$ref": "#/$defs/message_set" }
          }
        }
      }
    },
    "message_set": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/message_id" }
    },
    "audio": {
      "title": "audio.json: audio index",
      "description": "Which file holds which atom, option or trained message, and the expected composite hash and length of every message (held-out included). For #64: verify files against manifest.json, compose messages in memory per sound/docs/composition.md and compare with composite_sha256.",
      "oneOf": [{ "$ref": "#/$defs/audio_a" }, { "$ref": "#/$defs/audio_b" }]
    },
    "audio_a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "study", "package_id", "profile", "atoms", "messages"],
      "properties": {
        "format": { "const": "av-sound/package-audio" },
        "format_version": { "const": 1 },
        "study": { "const": "A" },
        "package_id": { "$ref": "#/$defs/package_id" },
        "profile": { "$ref": "#/$defs/profile" },
        "atoms": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atom_id", "path", "n_samples", "pcm_sha256", "file_sha256"],
            "properties": {
              "atom_id": { "$ref": "#/$defs/atom_id" },
              "path": { "type": "string", "pattern": "^atoms/[KQ]-[ar][1-4]\\.wav$" },
              "n_samples": { "$ref": "#/$defs/atom_samples" },
              "pcm_sha256": { "$ref": "#/$defs/sha256" },
              "file_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "messages": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_id",
              "action_atom",
              "referent_atom",
              "status",
              "n_samples",
              "duration_ms",
              "composite_sha256",
              "path",
              "file_sha256"
            ],
            "properties": {
              "message_id": { "$ref": "#/$defs/message_id" },
              "action_atom": { "type": "string", "pattern": "^[KQ]-a[1-4]$" },
              "referent_atom": { "type": "string", "pattern": "^[KQ]-r[1-4]$" },
              "status": { "enum": ["trained", "heldout"] },
              "n_samples": { "$ref": "#/$defs/message_samples" },
              "duration_ms": { "$ref": "#/$defs/message_ms" },
              "composite_sha256": {
                "description": "SHA-256 of action PCM + 19,200 zero bytes + referent PCM (composition.md section 3). For a trained message it equals the PCM hash of its WAV.",
                "$ref": "#/$defs/sha256"
              },
              "path": {
                "oneOf": [
                  { "type": "string", "pattern": "^messages/[KQ]-a[1-4]-r[1-4]\\.wav$" },
                  { "type": "null" }
                ]
              },
              "file_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
            },
            "if": { "properties": { "status": { "const": "heldout" } } },
            "then": { "properties": { "path": { "type": "null" }, "file_sha256": { "type": "null" } } },
            "else": { "properties": { "path": { "type": "string" }, "file_sha256": { "type": "string" } } }
          }
        }
      }
    },
    "audio_b": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "study", "package_id", "profiles", "waves", "options", "messages"],
      "properties": {
        "format": { "const": "av-sound/package-audio" },
        "format_version": { "const": 1 },
        "study": { "const": "B" },
        "package_id": { "$ref": "#/$defs/package_id" },
        "profiles": { "const": ["P1", "P2", "P3"] },
        "waves": {
          "description": "Wave manifest: atoms introduced at V1 (8), V2 (4) and V3 (4), in canonical order. The menu order comes from permutation.json wave_atom_order.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["wave", "visit", "atoms"],
            "properties": {
              "wave": { "$ref": "#/$defs/wave" },
              "visit": { "enum": ["V1", "V2", "V3"] },
              "atoms": {
                "type": "array",
                "minItems": 4,
                "maxItems": 8,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/atom_id" }
              }
            }
          }
        },
        "options": {
          "description": "192 option WAVs: 3 profiles x 16 atoms x 4 ranks (ranks 1-3 shown, rank 4 reserve).",
          "type": "array",
          "minItems": 192,
          "maxItems": 192,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "atom_id", "rank", "menu", "path", "n_samples", "pcm_sha256", "file_sha256"],
            "properties": {
              "profile": { "$ref": "#/$defs/profile" },
              "atom_id": { "$ref": "#/$defs/atom_id" },
              "rank": { "type": "integer", "minimum": 1, "maximum": 4 },
              "menu": { "enum": ["shown", "reserve"] },
              "path": { "type": "string", "pattern": "^options/P[123]/[KQ]-[ar][1-4]-[1-4]\\.wav$" },
              "n_samples": { "$ref": "#/$defs/atom_samples" },
              "pcm_sha256": { "$ref": "#/$defs/sha256" },
              "file_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "messages": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["message_id", "action_atom", "referent_atom", "status", "combinations"],
            "properties": {
              "message_id": { "$ref": "#/$defs/message_id" },
              "action_atom": { "type": "string", "pattern": "^[KQ]-a[1-4]$" },
              "referent_atom": { "type": "string", "pattern": "^[KQ]-r[1-4]$" },
              "status": { "enum": ["trained", "heldout"] },
              "combinations": {
                "description": "Every option combination: 3 profiles x 4 action ranks x 4 referent ranks.",
                "type": "array",
                "minItems": 48,
                "maxItems": 48,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["profile", "action_rank", "referent_rank", "n_samples", "duration_ms", "composite_sha256"],
                  "properties": {
                    "profile": { "$ref": "#/$defs/profile" },
                    "action_rank": { "type": "integer", "minimum": 1, "maximum": 4 },
                    "referent_rank": { "type": "integer", "minimum": 1, "maximum": 4 },
                    "n_samples": { "$ref": "#/$defs/message_samples" },
                    "duration_ms": { "$ref": "#/$defs/message_ms" },
                    "composite_sha256": { "$ref": "#/$defs/sha256" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "allocation": {
      "title": "allocation.json: allocation-dependent facts added at sealing",
      "description": "Restricted: the H-W1/H-W4 swap and the novel messages tested at each visit (and, in Study B, optionally the structured family). Never a method label, designer, role or seed.",
      "oneOf": [{ "$ref": "#/$defs/allocation_a" }, { "$ref": "#/$defs/allocation_b" }]
    },
    "allocation_a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "study", "package_id", "swap_w1_w4", "novel_by_visit"],
      "properties": {
        "format": { "const": "av-sound/package-allocation" },
        "format_version": { "const": 1 },
        "study": { "const": "A" },
        "package_id": { "$ref": "#/$defs/package_id" },
        "swap_w1_w4": { "type": "boolean" },
        "novel_by_visit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["D0", "D7"],
          "properties": {
            "D0": { "$ref": "#/$defs/message_set" },
            "D7": { "$ref": "#/$defs/message_set" }
          }
        }
      }
    },
    "allocation_b": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "study", "package_id", "swap_w1_w4", "novel_by_visit"],
      "properties": {
        "format": { "const": "av-sound/package-allocation" },
        "format_version": { "const": 1 },
        "study": { "const": "B" },
        "package_id": { "$ref": "#/$defs/package_id" },
        "swap_w1_w4": { "type": "boolean" },
        "structured_family": { "$ref": "#/$defs/family" },
        "novel_by_visit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["V1", "V2", "V3", "W1", "W4"],
          "properties": {
            "V1": { "$ref": "#/$defs/message_set" },
            "V2": { "$ref": "#/$defs/message_set" },
            "V3": { "$ref": "#/$defs/message_set" },
            "W1": { "$ref": "#/$defs/message_set" },
            "W4": { "$ref": "#/$defs/message_set" }
          }
        }
      }
    }
  }
}
