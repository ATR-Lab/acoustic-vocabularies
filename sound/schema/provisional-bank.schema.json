{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/blob/main/sound/schema/provisional-bank.schema.json",
  "title": "PROVISIONAL Study B dyad bank (package-builder input)",
  "description": "Provisional input of the dyad package builder (#13, av_sound.dyad_bank) until the B bank builder (#26) defines the real bank manifest. One frozen bank per dyad: for each profile and atom, the four retained options in rank order (ranks 1-3 are the displayed menu, rank 4 is the reserve; Study B protocol §4), each with its recipe and the SHA-256 of its rendered int16 samples, plus the semantic label bound to each atom (the dyad's stored permutation, #29). The builder re-renders every option and checks the hash. Option source values are opaque provenance and are never copied into a package. See docs/interfaces/package-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "provisional", "bank_id", "demo", "labels", "cells"],
  "properties": {
    "format": { "const": "av-sound/provisional-bank" },
    "format_version": { "const": 1 },
    "provisional": { "const": true },
    "bank_id": {
      "description": "Anonymous bank ID (same rules as a store book ID). DEMO banks, and only they, start with DEMO-.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,62}[A-Za-z0-9]$"
    },
    "demo": { "type": "boolean" },
    "labels": {
      "description": "Atom ID -> semantic label (ontology label of the atom's family and role; a permutation per family and role).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "K-a1", "K-a2", "K-a3", "K-a4", "K-r1", "K-r2", "K-r3", "K-r4",
        "Q-a1", "Q-a2", "Q-a3", "Q-a4", "Q-r1", "Q-r2", "Q-r3", "Q-r4"
      ],
      "properties": {
        "K-a1": { "$ref": "#/$defs/k_action" },
        "K-a2": { "$ref": "#/$defs/k_action" },
        "K-a3": { "$ref": "#/$defs/k_action" },
        "K-a4": { "$ref": "#/$defs/k_action" },
        "K-r1": { "$ref": "#/$defs/k_referent" },
        "K-r2": { "$ref": "#/$defs/k_referent" },
        "K-r3": { "$ref": "#/$defs/k_referent" },
        "K-r4": { "$ref": "#/$defs/k_referent" },
        "Q-a1": { "$ref": "#/$defs/q_action" },
        "Q-a2": { "$ref": "#/$defs/q_action" },
        "Q-a3": { "$ref": "#/$defs/q_action" },
        "Q-a4": { "$ref": "#/$defs/q_action" },
        "Q-r1": { "$ref": "#/$defs/q_referent" },
        "Q-r2": { "$ref": "#/$defs/q_referent" },
        "Q-r3": { "$ref": "#/$defs/q_referent" },
        "Q-r4": { "$ref": "#/$defs/q_referent" }
      }
    },
    "cells": {
      "description": "48 cells: one per profile and atom.",
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "atom_id", "options"],
        "properties": {
          "profile": { "enum": ["P1", "P2", "P3"] },
          "atom_id": { "type": "string", "pattern": "^[KQ]-[ar][1-4]$" },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rank", "recipe", "pcm_sha256"],
              "properties": {
                "rank": {
                  "description": "1-3: displayed menu position; 4: reserve.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "recipe": { "$ref": "recipe.schema.json" },
                "pcm_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "source": {
                  "description": "Opaque provenance (bank attempt and slot). Never copied into a package.",
                  "type": "string",
                  "pattern": "^[!-~]{1,128}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "k_action": { "enum": ["ADD_ONE", "REMOVE_ONE", "FLIP_CARD", "ALIGN_ARROW"] },
    "k_referent": { "enum": ["A", "B", "C", "D"] },
    "q_action": { "enum": ["SCAN", "TAG", "CLOSE", "QUARANTINE"] },
    "q_referent": { "enum": ["E", "F", "G", "H"] }
  }
}
