{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/schedules/schema/permutation.schema.json",
  "title": "Unit permutation (permutation.json)",
  "description": "Package-safe description of one Study A batch or Study B dyad slot: semantic labels at matrix indices, atom introduction order and the 32 abstract message cells. It contains nothing derived from the allocation cell (no SQ arm, scaffold families, H-W1/H-W4 swap, novel-test schedule, block or grid position) and no derived seeds, so it may travel in learner packages and be read by the bank builder before allocation. Allocation-dependent fields are added at package sealing from the restricted outputs. Written by av_schedules; see docs/interfaces/schedules.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "generator",
    "demo",
    "seed_label",
    "study",
    "set",
    "unit_id",
    "unit_kind",
    "shared_by",
    "family_first",
    "labels",
    "atoms",
    "atom_order",
    "messages"
  ],
  "properties": {
    "format": {"const": "av-schedules/permutation"},
    "format_version": {"const": 2},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "av-schedules"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "demo": {"type": "boolean", "description": "True when generated from a public DEMO- seed; such units must never be used with participants."},
    "seed_label": {
      "type": "string",
      "pattern": "^(DEMO-[A-Za-z0-9._-]{1,64}|sha256:[0-9a-f]{64})$",
      "description": "The DEMO- seed itself, or sha256:<SHA-256 of the private master seed>."
    },
    "study": {"enum": ["A", "B"]},
    "set": {"enum": ["pilot", "confirmatory"]},
    "unit_id": {"type": "string", "pattern": "^(A-[PC][0-9]{2}|B-[PCS][0-9]{2})$"},
    "unit_kind": {"enum": ["batch", "dyad", "spare"]},
    "shared_by": {
      "enum": ["batch", "dyad"],
      "description": "batch: all three method books of the Study A batch; dyad: both members of the Study B dyad."
    },
    "family_first": {"$ref": "#/$defs/family"},
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["K", "Q"],
      "description": "Semantic labels at matrix indices 1..4 (array position i holds the label of index i+1).",
      "properties": {
        "K": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "referent"],
          "properties": {
            "action": {"$ref": "#/$defs/labelsK_action"},
            "referent": {"$ref": "#/$defs/labelsK_referent"}
          }
        },
        "Q": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "referent"],
          "properties": {
            "action": {"$ref": "#/$defs/labelsQ_action"},
            "referent": {"$ref": "#/$defs/labelsQ_referent"}
          }
        }
      }
    },
    "atoms": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_id", "family", "role", "index", "semantic_label", "matrix_wave", "order_position"],
        "properties": {
          "atom_id": {"$ref": "#/$defs/atom_id"},
          "family": {"$ref": "#/$defs/family"},
          "role": {"enum": ["action", "referent"]},
          "index": {"$ref": "#/$defs/index"},
          "semantic_label": {"$ref": "#/$defs/label"},
          "matrix_wave": {"$ref": "#/$defs/wave"},
          "order_position": {"type": "integer", "minimum": 1, "maximum": 16}
        }
      }
    },
    "atom_order": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/atom_id"},
      "description": "Atom introduction order. Study A: generation/commit and atomic-lesson order shared by the batch. Study B: wave 1, 2, 3 menu orders concatenated (also the bank traversal order)."
    },
    "wave_atom_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3"],
      "description": "Study B only: menu order of the atoms introduced at each wave.",
      "properties": {
        "1": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/atom_id"}},
        "2": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/atom_id"}},
        "3": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/atom_id"}}
      }
    },
    "messages": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "family",
          "action_atom",
          "referent_atom",
          "semantic_action",
          "semantic_referent",
          "status",
          "training_wave",
          "heldout_set"
        ],
        "properties": {
          "message_id": {"type": "string", "pattern": "^[KQ]-a[1-4]-r[1-4]$"},
          "family": {"$ref": "#/$defs/family"},
          "action_atom": {"type": "string", "pattern": "^[KQ]-a[1-4]$"},
          "referent_atom": {"type": "string", "pattern": "^[KQ]-r[1-4]$"},
          "semantic_action": {"$ref": "#/$defs/label"},
          "semantic_referent": {"$ref": "#/$defs/label"},
          "status": {"enum": ["trained", "heldout"]},
          "training_wave": {"oneOf": [{"$ref": "#/$defs/wave"}, {"type": "null"}]},
          "heldout_set": {
            "oneOf": [{"$ref": "#/$defs/heldout_set"}, {"type": "null"}],
            "description": "Abstract held-out set of the cell (the same for every unit); which set is tested at which visit depends on the swap and is not in this file."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"study": {"const": "A"}}},
      "then": {
        "not": {"required": ["wave_atom_order"]},
        "properties": {"unit_kind": {"const": "batch"}, "shared_by": {"const": "batch"}}
      }
    },
    {
      "if": {"properties": {"study": {"const": "B"}}},
      "then": {
        "required": ["wave_atom_order"],
        "properties": {"unit_kind": {"enum": ["dyad", "spare"]}, "shared_by": {"const": "dyad"}}
      }
    }
  ],
  "$defs": {
    "family": {"enum": ["K", "Q"]},
    "index": {"type": "integer", "minimum": 1, "maximum": 4},
    "wave": {"type": "integer", "minimum": 1, "maximum": 3},
    "atom_id": {"type": "string", "pattern": "^[KQ]-[ar][1-4]$"},
    "heldout_set": {"enum": ["H-V1", "H-V2", "H-V3", "H-W1", "H-W4"]},
    "label": {
      "enum": ["ADD_ONE", "REMOVE_ONE", "FLIP_CARD", "ALIGN_ARROW", "A", "B", "C", "D", "SCAN", "TAG", "CLOSE", "QUARANTINE", "E", "F", "G", "H"]
    },
    "labelsK_action": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["ADD_ONE", "REMOVE_ONE", "FLIP_CARD", "ALIGN_ARROW"]}
    },
    "labelsK_referent": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["A", "B", "C", "D"]}
    },
    "labelsQ_action": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["SCAN", "TAG", "CLOSE", "QUARANTINE"]}
    },
    "labelsQ_referent": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["E", "F", "G", "H"]}
    }
  }
}
