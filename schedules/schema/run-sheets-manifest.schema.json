{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/schedules/schema/run-sheets-manifest.schema.json",
  "title": "Run-sheet manifest (<set>-run-sheets-manifest.json)",
  "description": "Template, sources, bookings and file hashes of one study's run-sheet set. Written only after the schedule validation suite reported no finding. Its SHA-256 may be published for restricted sets. See docs/interfaces/schedules.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "generator",
    "demo",
    "seed_label",
    "study",
    "set",
    "template",
    "schedules_manifest_sha256",
    "package_hashes",
    "units",
    "spare_units",
    "persons",
    "screening_booked_minutes",
    "visits",
    "checks",
    "files"
  ],
  "properties": {
    "format": {"const": "av-schedules/run-sheets-manifest"},
    "format_version": {"const": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "av-schedules"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "demo": {"type": "boolean"},
    "seed_label": {"type": "string", "pattern": "^(DEMO-[A-Za-z0-9._-]{1,64}|sha256:[0-9a-f]{64})$"},
    "study": {"enum": ["A", "B"]},
    "set": {"enum": ["pilot", "confirmatory"]},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "columns", "prefilled"],
      "properties": {
        "name": {"const": "visit-run-sheet-template.csv"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "columns": {
          "const": ["participant_id", "visit", "block", "expected_count", "actual_count", "start_time", "end_time", "comfort_check", "phone_locked", "hash_check", "deviations", "operator_signoff"]
        },
        "prefilled": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "schedules_manifest_sha256": {"$ref": "#/$defs/sha256", "description": "SHA-256 of the <set>-schedules-manifest.json the run sheets were built from."},
    "package_hashes": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "demo", "placeholder", "packages"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256"},
            "demo": {"type": "boolean"},
            "placeholder": {"type": "boolean"},
            "packages": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "units": {"type": "array", "items": {"type": "string"}},
    "spare_units": {"type": "array", "items": {"type": "string"}},
    "persons": {"type": "integer", "minimum": 1},
    "screening_booked_minutes": {"type": ["integer", "null"], "description": "Study B screening visit (20 min); null for Study A."},
    "visits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocks", "booked_minutes", "scheduled_seconds"],
        "properties": {
          "blocks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "booked_minutes": {"type": "integer", "minimum": 1},
          "scheduled_seconds": {"type": "integer", "minimum": 1}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "schedules"],
      "properties": {
        "findings": {"const": 0},
        "schedules": {"type": "integer", "minimum": 1}
      }
    },
    "files": {
      "type": "object",
      "description": "SHA-256 of the bytes of every other file of the set, by path.",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
