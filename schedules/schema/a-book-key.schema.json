{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/schedules/schema/a-book-key.schema.json",
  "title": "Study A restricted book key (<set>-book-key.json)",
  "description": "Maps each anonymous book ID to its batch, method and (A1) designer. Held by the study coordinator; input to unmasking in the analysis pipeline. Never given to masked staff or the operator console. See docs/interfaces/schedules.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "audience",
    "generator",
    "demo",
    "seed_label",
    "allocation_seed",
    "study",
    "set",
    "design_table_sha256",
    "slots_list_sha256",
    "books",
    "list_sha256"
  ],
  "properties": {
    "format": {"const": "av-schedules/a-book-key"},
    "format_version": {"const": 1},
    "audience": {"const": "restricted"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "av-schedules"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "demo": {"type": "boolean"},
    "seed_label": {"type": "string", "pattern": "^(DEMO-[A-Za-z0-9._-]{1,64}|sha256:[0-9a-f]{64})$"},
    "allocation_seed": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "study": {"const": "A"},
    "set": {"enum": ["pilot", "confirmatory"]},
    "design_table_sha256": {"$ref": "#/$defs/sha256"},
    "slots_list_sha256": {"$ref": "#/$defs/sha256", "description": "list_sha256 of the learner-facing slot list this key belongs to."},
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["book_id", "unit_id", "method", "designer", "slots"],
        "properties": {
          "book_id": {"type": "string", "pattern": "^BK-[PC]-[BCFGHJKMNPQRTVWXY4-9]{6}$"},
          "unit_id": {"type": "string", "pattern": "^A-[PC][0-9]{2}$"},
          "method": {"enum": ["A1", "A2", "A3"]},
          "designer": {"type": ["string", "null"], "pattern": "^D[1-3]$", "description": "Anonymous A1 designer ID; null for A2 and A3."},
          "slots": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^A-[PC][0-9]{2}-L(0[1-9]|1[0-2])$"}
          }
        },
        "if": {"properties": {"method": {"const": "A1"}}},
        "then": {"properties": {"designer": {"type": "string"}}},
        "else": {"properties": {"designer": {"type": "null"}}}
      }
    },
    "list_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
