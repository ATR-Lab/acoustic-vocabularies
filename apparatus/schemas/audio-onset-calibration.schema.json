{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/audio-onset-calibration.schema.json",
  "title": "Audio onset calibration record (#80)",
  "description": "Output of tools/onset_calibration.py for one station, route, device setting set and capture channel. The tool only writes status provisional; qualified requires a physical acoustic measurement, review and either a met target or a signed response-time qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "status",
    "evidence_kind",
    "station_id",
    "route",
    "connection_mode",
    "play_mode",
    "app_build_id",
    "output_device",
    "capture_interface",
    "capture_kind",
    "app_sample_rate_hz",
    "capture_sample_rate_hz",
    "buffer_frames",
    "buffer_count",
    "volume",
    "full_scene_loaded",
    "reference_field",
    "measured_at",
    "detector",
    "sync",
    "plays",
    "route_offset_ms",
    "offset_sd_ms",
    "residual_abs_p95_ms",
    "residual_abs_max_ms",
    "onset_uncertainty_ms",
    "target",
    "loopback_reference",
    "inputs",
    "outputs",
    "response_time_qualification",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_kind": {
      "const": "audio_onset_calibration"
    },
    "status": {
      "enum": [
        "provisional",
        "qualified"
      ]
    },
    "evidence_kind": {
      "enum": [
        "physical_measurement",
        "synthetic_fixture"
      ]
    },
    "station_id": {
      "$ref": "#/$defs/id"
    },
    "route": {
      "$ref": "#/$defs/id"
    },
    "connection_mode": {
      "enum": [
        "headset_speakers",
        "wired_3_5mm_earphones",
        "link_pc_headphones"
      ]
    },
    "play_mode": {
      "enum": [
        "plain",
        "scheduled"
      ]
    },
    "app_build_id": {
      "$ref": "#/$defs/text"
    },
    "output_device": {
      "$ref": "#/$defs/text"
    },
    "capture_interface": {
      "$ref": "#/$defs/text"
    },
    "capture_kind": {
      "enum": [
        "acoustic_coupler",
        "electrical_loopback"
      ]
    },
    "app_sample_rate_hz": {
      "const": 48000
    },
    "capture_sample_rate_hz": {
      "enum": [
        44100,
        48000,
        88200,
        96000,
        192000
      ]
    },
    "buffer_frames": {
      "type": "integer",
      "minimum": 64,
      "maximum": 8192
    },
    "buffer_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "max_step"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "full_scene_loaded": {
      "type": "boolean"
    },
    "reference_field": {
      "enum": [
        "audio_request_mono_ms",
        "scheduled_onset_mono_ms"
      ]
    },
    "measured_at": {
      "$ref": "#/$defs/timestamp"
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tool",
        "measure_channel",
        "reference_channel",
        "threshold_fs",
        "consecutive_samples",
        "quiet_pre_ms",
        "search_start_ms",
        "search_end_ms",
        "threshold_source",
        "quantile_method"
      ],
      "properties": {
        "version": {
          "const": "onset-threshold/1"
        },
        "tool": {
          "const": "tools/onset_calibration.py"
        },
        "measure_channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "reference_channel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 63
        },
        "threshold_fs": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "consecutive_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "quiet_pre_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "search_start_ms": {
          "type": "number",
          "minimum": -1000,
          "maximum": 5000
        },
        "search_end_ms": {
          "type": "number",
          "minimum": -1000,
          "maximum": 5000
        },
        "threshold_source": {
          "$ref": "#/$defs/text"
        },
        "quantile_method": {
          "const": "linear_interpolation_hyndman_fan_7"
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "fit_n",
        "check_n",
        "slope",
        "intercept_s",
        "heldout_p95_ms",
        "heldout_max_ms",
        "external_bound_ms",
        "bound_ms",
        "evidence"
      ],
      "properties": {
        "model": {
          "const": "affine_capture_s_from_host_ms/1"
        },
        "fit_n": {
          "type": "integer",
          "minimum": 3
        },
        "check_n": {
          "type": "integer",
          "minimum": 3
        },
        "slope": {
          "type": "number",
          "minimum": 0.99,
          "maximum": 1.01
        },
        "intercept_s": {
          "type": "number"
        },
        "heldout_p95_ms": {
          "$ref": "#/$defs/nonnegative"
        },
        "heldout_max_ms": {
          "$ref": "#/$defs/nonnegative"
        },
        "external_bound_ms": {
          "$ref": "#/$defs/nonnegative"
        },
        "bound_ms": {
          "$ref": "#/$defs/nonnegative"
        },
        "evidence": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "plays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "matched",
        "missing",
        "clipped",
        "contaminated",
        "outside_capture",
        "coverage"
      ],
      "properties": {
        "requested": {
          "type": "integer",
          "minimum": 1
        },
        "matched": {
          "$ref": "#/$defs/count"
        },
        "missing": {
          "$ref": "#/$defs/count"
        },
        "clipped": {
          "$ref": "#/$defs/count"
        },
        "contaminated": {
          "$ref": "#/$defs/count"
        },
        "outside_capture": {
          "$ref": "#/$defs/count"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "P1",
            "P2",
            "P3"
          ],
          "properties": {
            "P1": {
              "$ref": "#/$defs/kind_counts"
            },
            "P2": {
              "$ref": "#/$defs/kind_counts"
            },
            "P3": {
              "$ref": "#/$defs/kind_counts"
            }
          }
        }
      }
    },
    "route_offset_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "offset_sd_ms": {
      "$ref": "#/$defs/nullable_nonnegative"
    },
    "residual_abs_p95_ms": {
      "$ref": "#/$defs/nullable_nonnegative"
    },
    "residual_abs_max_ms": {
      "$ref": "#/$defs/nullable_nonnegative"
    },
    "onset_uncertainty_ms": {
      "$ref": "#/$defs/nullable_nonnegative"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "p95_limit_ms",
        "min_plays",
        "met"
      ],
      "properties": {
        "rule": {
          "const": "onset-target/1"
        },
        "p95_limit_ms": {
          "const": 20
        },
        "min_plays": {
          "const": 200
        },
        "met": {
          "type": "boolean"
        }
      }
    },
    "loopback_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "matched",
            "median_delta_ms",
            "delta_abs_deviation_p95_ms"
          ],
          "properties": {
            "channel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "matched": {
              "$ref": "#/$defs/count"
            },
            "median_delta_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "delta_abs_deviation_p95_ms": {
              "$ref": "#/$defs/nullable_nonnegative"
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_wav_sha256",
        "events_csv_sha256",
        "sync_csv_sha256",
        "settings_json_sha256"
      ],
      "properties": {
        "capture_wav_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "events_csv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sync_csv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "settings_json_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plays_csv_sha256",
        "histogram_csv_sha256"
      ],
      "properties": {
        "plays_csv_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "histogram_csv_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "response_time_qualification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "signed_by",
            "signed_at"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "signed_by": {
              "$ref": "#/$defs/text"
            },
            "signed_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      ]
    },
    "review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewed_by",
            "reviewed_at"
          ],
          "properties": {
            "reviewed_by": {
              "$ref": "#/$defs/text"
            },
            "reviewed_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "evidence_kind"
        ],
        "properties": {
          "evidence_kind": {
            "const": "synthetic_fixture"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "provisional"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "required": [
              "met"
            ],
            "properties": {
              "met": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "route_offset_ms": {
            "type": "number"
          },
          "onset_uncertainty_ms": {
            "type": "number",
            "maximum": 20
          },
          "plays": {
            "properties": {
              "matched": {
                "minimum": 200
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "qualified"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "physical_measurement"
          },
          "capture_kind": {
            "const": "acoustic_coupler"
          },
          "full_scene_loaded": {
            "const": true
          },
          "route_offset_ms": {
            "type": "number"
          },
          "onset_uncertainty_ms": {
            "type": "number"
          },
          "review": {
            "type": "object"
          }
        },
        "anyOf": [
          {
            "properties": {
              "target": {
                "properties": {
                  "met": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "response_time_qualification": {
                "type": "object"
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,512}(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "nonnegative": {
      "type": "number",
      "minimum": 0
    },
    "nullable_nonnegative": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "kind_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom",
        "message"
      ],
      "properties": {
        "atom": {
          "$ref": "#/$defs/count"
        },
        "message": {
          "$ref": "#/$defs/count"
        }
      }
    }
  }
}
