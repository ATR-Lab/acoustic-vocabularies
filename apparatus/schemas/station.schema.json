{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/acoustic-vocab/station.schema.json",
  "title": "Foundation engineering station configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "station_id",
    "headset_unit_id",
    "provisioning_status",
    "topology",
    "robot_state_source",
    "isaac_endpoint",
    "audio",
    "input_method",
    "refresh_hz",
    "tracking_origin_mode",
    "observer_reference"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "station_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "headset_unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "provisioning_status": {
      "type": "string",
      "enum": [
        "example_only",
        "provisioned"
      ]
    },
    "topology": {
      "type": "string",
      "enum": [
        "standalone_quest",
        "pcvr_link"
      ]
    },
    "robot_state_source": {
      "type": "string",
      "enum": [
        "live",
        "snapshot"
      ]
    },
    "isaac_endpoint": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^wss?://[^\\s]+(?![\\s\\S])"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "buffer_samples",
        "route_offset_ms"
      ],
      "properties": {
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "buffer_samples": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "level_calibration": {
          "description": "Coupler measurement taken at station install. The app refuses to play study sound without it and caps every comfortable gain at 80 dB(A) peak at the ear (decision I7).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "ear_peak_dba_at_0dbfs",
            "measured_on",
            "coupler_id"
          ],
          "properties": {
            "route": {
              "description": "Audio route measured; must equal audio.route, so a route change needs a new measurement.",
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
            },
            "ear_peak_dba_at_0dbfs": {
              "description": "dB(A) peak at the ear for a 0 dBFS peak played at gain 0 dB (linear gain 1).",
              "type": "number",
              "minimum": 40,
              "maximum": 140
            },
            "measured_on": {
              "description": "Measurement date, YYYY-MM-DD.",
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
            },
            "coupler_id": {
              "description": "Identifier of the coupler and meter used.",
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
            }
          }
        },
        "route_offset_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "input_method": {
      "type": "string",
      "enum": [
        "controllers",
        "hands"
      ]
    },
    "refresh_hz": {
      "type": "integer",
      "enum": [
        72,
        80,
        90,
        120
      ]
    },
    "tracking_origin_mode": {
      "type": "string",
      "enum": [
        "device"
      ]
    },
    "observer_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_frame",
        "calibration_id",
        "position_m",
        "rotation_xyzw"
      ],
      "properties": {
        "coordinate_frame": {
          "type": "string",
          "enum": [
            "unity_lh_y_up_m"
          ]
        },
        "calibration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "position_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          }
        },
        "rotation_xyzw": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "description": "Runtime also requires unit quaternion (norm squared tolerance 0.0001) and yaw-only world-up rotation (absolute X/Z component tolerance 0.0001)."
        }
      }
    }
  }
}
