{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/audio-onset-calibration-settings.schema.json",
  "title": "Audio onset calibration run settings (#80 input to tools/onset_calibration.py)",
  "description": "Operator-declared device settings and frozen detector parameters for one capture. The analysis copies these into the calibration record; it never infers them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "station_id",
    "route",
    "connection_mode",
    "play_mode",
    "app_build_id",
    "output_device",
    "capture_interface",
    "capture_kind",
    "app_sample_rate_hz",
    "capture_sample_rate_hz",
    "buffer_frames",
    "buffer_count",
    "volume",
    "full_scene_loaded",
    "reference_field",
    "measured_at",
    "sync",
    "detector"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_kind": {
      "enum": [
        "physical_measurement",
        "synthetic_fixture"
      ]
    },
    "station_id": {
      "$ref": "#/$defs/id"
    },
    "route": {
      "$ref": "#/$defs/id"
    },
    "connection_mode": {
      "$ref": "#/$defs/connection_mode"
    },
    "play_mode": {
      "enum": [
        "plain",
        "scheduled"
      ]
    },
    "app_build_id": {
      "$ref": "#/$defs/text"
    },
    "output_device": {
      "$ref": "#/$defs/text"
    },
    "capture_interface": {
      "$ref": "#/$defs/text"
    },
    "capture_kind": {
      "enum": [
        "acoustic_coupler",
        "electrical_loopback"
      ]
    },
    "app_sample_rate_hz": {
      "const": 48000
    },
    "capture_sample_rate_hz": {
      "enum": [
        44100,
        48000,
        88200,
        96000,
        192000
      ]
    },
    "buffer_frames": {
      "type": "integer",
      "minimum": 64,
      "maximum": 8192
    },
    "buffer_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "volume": {
      "$ref": "#/$defs/volume"
    },
    "full_scene_loaded": {
      "type": "boolean"
    },
    "reference_field": {
      "description": "Logged host time that offsets are measured from. Fixed to scheduled_onset_mono_ms: Unity's AudioTiming.Schedule starts output at the requested onset minus route_offset_ms and logs that start as scheduled_onset_mono_ms, so the onset estimate is that field plus the offset. audio_request_mono_ms is refused.",
      "const": "scheduled_onset_mono_ms"
    },
    "measured_at": {
      "$ref": "#/$defs/timestamp"
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_bound_ms",
        "evidence"
      ],
      "properties": {
        "external_bound_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "evidence": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measure_channel",
        "reference_channel",
        "threshold_fs",
        "consecutive_samples",
        "quiet_pre_ms",
        "search_start_ms",
        "search_end_ms",
        "threshold_source"
      ],
      "properties": {
        "measure_channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "reference_channel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 63
        },
        "threshold_fs": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "consecutive_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "quiet_pre_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "search_start_ms": {
          "type": "number",
          "minimum": -1000,
          "maximum": 5000
        },
        "search_end_ms": {
          "type": "number",
          "minimum": -1000,
          "maximum": 5000
        },
        "threshold_source": {
          "$ref": "#/$defs/text"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,512}(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "connection_mode": {
      "enum": [
        "headset_speakers",
        "wired_3_5mm_earphones",
        "link_pc_headphones"
      ]
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "max_step"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    }
  }
}
