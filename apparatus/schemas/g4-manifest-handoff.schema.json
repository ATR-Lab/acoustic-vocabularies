{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apparatus/g4-manifest-handoff.schema.json",
  "title": "g4-manifest-handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "freeze_reference",
    "freeze_status",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "record_type": {
      "const": "g4-generation-freeze-handoff"
    },
    "freeze_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\x00-\\x1f]+$"
    },
    "freeze_status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id_provisional",
        "model_revision",
        "runtime_precision",
        "prompt_hash",
        "fallback_bank_hash",
        "renderer_recipe_schema_hash"
      ],
      "properties": {
        "model_id_provisional": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f]+$"
            },
            {
              "$ref": "#/$defs/pending"
            }
          ]
        },
        "model_revision": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f]+$"
            },
            {
              "$ref": "#/$defs/pending"
            }
          ]
        },
        "runtime_precision": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\x00-\\x1f]+$"
            },
            {
              "$ref": "#/$defs/pending"
            }
          ]
        },
        "prompt_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "$ref": "#/$defs/pending"
            }
          ]
        },
        "fallback_bank_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "$ref": "#/$defs/pending"
            }
          ]
        },
        "renderer_recipe_schema_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "$ref": "#/$defs/pending"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "freeze_status"
        ],
        "properties": {
          "freeze_status": {
            "const": "frozen"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f]+$"
        }
      }
    }
  }
}
