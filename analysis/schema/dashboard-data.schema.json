{
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/analysis/schema/dashboard-data.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Panel metrics of the masked integrity dashboard (#35), computed from the allow-listed columns of reconciled/visit-status.csv, discrepancies.csv and enrollment.csv only. Counts, coded IDs, enumerations and generated text: no outcome, response, rating, condition, personal name or contact field (masking policy 'masked'). See analysis/docs/monitoring.md.",
  "properties": {
    "alerts": {
      "additionalProperties": false,
      "properties": {
        "suspension": {
          "description": "Red alerts: one entry per suspension event raised (analysis plan section 8).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "codes": {
                "items": {
                  "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
                  "type": "string"
                },
                "type": "array"
              },
              "discrepancies_n": {
                "minimum": 0,
                "type": "integer"
              },
              "event": {
                "enum": [
                  "WRONG_FILE_MAPPING",
                  "ANSWER_LEAK",
                  "OLD_WAVEFORM_CHANGED"
                ]
              },
              "title": {
                "enum": [
                  "Wrong-file mapping",
                  "Leaked answer display",
                  "Changed old waveform"
                ]
              },
              "unresolved_n": {
                "minimum": 0,
                "type": "integer"
              },
              "visit_ids": {
                "items": {
                  "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}-D[07]|B-[PCS][0-9]{2}-M[12]-(V[1-3]|W[14]))$",
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "event",
              "title",
              "visit_ids",
              "codes",
              "discrepancies_n",
              "unresolved_n"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "triggers": {
          "description": "Amber triggers (feasibility triggers, enrollment stop, reconciliation).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "message": {
                "description": "Generated from constants and counts.",
                "minLength": 1,
                "type": "string"
              },
              "set": {
                "enum": [
                  "pilot",
                  "confirmatory",
                  null
                ]
              },
              "study": {
                "enum": [
                  "A",
                  "B",
                  null
                ]
              },
              "trigger": {
                "enum": [
                  "target_reached",
                  "target_exceeded",
                  "enrollment_mismatch",
                  "fault_rate",
                  "overrun_share",
                  "reconciliation_failed",
                  "not_reconciled",
                  "pair_gap"
                ]
              }
            },
            "required": [
              "trigger",
              "study",
              "set",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "suspension",
        "triggers"
      ],
      "type": "object"
    },
    "allocation": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "set": {
            "enum": [
              "pilot",
              "confirmatory"
            ]
          },
          "study": {
            "enum": [
              "A",
              "B"
            ]
          },
          "units": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "planned_persons_n": {
                  "minimum": 0,
                  "type": "integer"
                },
                "revealed_persons_n": {
                  "minimum": 0,
                  "type": "integer"
                },
                "unit_id": {
                  "pattern": "^(A-[PC][0-9]{2}|B-[PCS][0-9]{2})$",
                  "type": "string"
                },
                "unit_kind": {
                  "enum": [
                    "batch",
                    "dyad",
                    "spare"
                  ]
                },
                "visits": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "expected_n": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "held_n": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "missed_n": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "pending_n": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "visit": {
                        "enum": [
                          "D0",
                          "D7",
                          "V1",
                          "V2",
                          "V3",
                          "W1",
                          "W4"
                        ]
                      },
                      "withdrawn_n": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "visit",
                      "expected_n",
                      "held_n",
                      "missed_n",
                      "withdrawn_n",
                      "pending_n"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "unit_id",
                "unit_kind",
                "planned_persons_n",
                "revealed_persons_n",
                "visits"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "study",
          "set",
          "units"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "analyzer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "av-analysis"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "as_of": {
      "additionalProperties": false,
      "description": "Last update: the latest visit date and reveal-log date of the inputs (no wall clock).",
      "properties": {
        "data_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "latest_reveal_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "latest_visit_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "data_date",
        "latest_visit_date",
        "latest_reveal_date"
      ],
      "type": "object"
    },
    "attrition": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "missed_visit_ids": {
            "items": {
              "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}-D[07]|B-[PCS][0-9]{2}-M[12]-(V[1-3]|W[14]))$",
              "type": "string"
            },
            "type": "array"
          },
          "persons_n": {
            "minimum": 0,
            "type": "integer"
          },
          "set": {
            "enum": [
              "pilot",
              "confirmatory"
            ]
          },
          "study": {
            "enum": [
              "A",
              "B"
            ]
          },
          "visits": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "expected_n": {
                  "minimum": 0,
                  "type": "integer"
                },
                "held_n": {
                  "minimum": 0,
                  "type": "integer"
                },
                "missed_n": {
                  "minimum": 0,
                  "type": "integer"
                },
                "pending_n": {
                  "minimum": 0,
                  "type": "integer"
                },
                "visit": {
                  "enum": [
                    "D0",
                    "D7",
                    "V1",
                    "V2",
                    "V3",
                    "W1",
                    "W4"
                  ]
                },
                "withdrawn_n": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "visit",
                "expected_n",
                "held_n",
                "missed_n",
                "withdrawn_n",
                "pending_n"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "withdrawals": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "person_id": {
                  "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}|B-[PCS][0-9]{2}-M[12])$",
                  "type": "string"
                },
                "visit": {
                  "enum": [
                    "D0",
                    "D7",
                    "V1",
                    "V2",
                    "V3",
                    "W1",
                    "W4"
                  ]
                }
              },
              "required": [
                "person_id",
                "visit"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "withdrawn_persons_n": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "study",
          "set",
          "persons_n",
          "withdrawn_persons_n",
          "visits",
          "missed_visit_ids",
          "withdrawals"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "data_kind": {
      "description": "Watermark (paths).",
      "enum": [
        "SYNTHETIC",
        "REAL"
      ]
    },
    "enrollment": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bank_unavailable_n": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "eligibility_records_n": {
            "minimum": 0,
            "type": "integer"
          },
          "eligible_persons_n": {
            "minimum": 0,
