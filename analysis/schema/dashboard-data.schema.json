              "null"
            ]
          },
          "set": {
            "enum": [
              "pilot",
              "confirmatory"
            ]
          },
          "spares_used_n": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "study": {
            "enum": [
              "A",
              "B"
            ]
          },
          "target_books_n": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "target_persons_n": {
            "minimum": 0,
            "type": "integer"
          },
          "target_reached": {
            "type": "boolean"
          },
          "target_units_n": {
            "minimum": 0,
            "type": "integer"
          },
          "tracked_persons_n": {
            "minimum": 0,
            "type": "integer"
          },
          "unit_kind": {
            "enum": [
              "batch",
              "dyad"
            ]
          }
        },
        "required": [
          "study",
          "set",
          "unit_kind",
          "target_units_n",
          "target_persons_n",
          "target_books_n",
          "planned_units_n",
          "planned_persons_n",
          "eligibility_records_n",
          "eligible_persons_n",
          "screening_cases_n",
          "revealed_units_n",
          "revealed_persons_n",
          "spares_used_n",
          "bank_unavailable_n",
          "last_event_date",
          "remaining_persons_n",
          "target_reached",
          "tracked_persons_n"
        ],
        "type": "object"
      },
      "type": "array"
    },
