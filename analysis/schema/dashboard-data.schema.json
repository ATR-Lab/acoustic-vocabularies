              },
              "fault_n": {
                "minimum": 0,
                "type": "integer"
              },
              "fault_rate": {
                "maximum": 1,
                "minimum": 0,
                "type": [
                  "number",
                  "null"
                ]
              },
              "held_visits_n": {
                "minimum": 0,
