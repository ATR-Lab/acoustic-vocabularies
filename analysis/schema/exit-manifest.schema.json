{
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/analysis/schema/exit-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SHA-256 and size of every raw file of a visit, saved when the session closes (Common procedures section 7: save and hash raw logs at exit). Check C1 compares the files with it. Producer: data logging (#72) / operator console (#73); the field-by-field agreement is Pending. The synthetic log generator (#33) writes it.",
  "properties": {
    "closed": {
      "description": "interrupted: partial logs preserved after a stop or crash.",
      "enum": [
        "complete",
        "interrupted"
      ]
    },
    "data_kind": {
      "description": "Watermark (paths).",
      "enum": [
        "SYNTHETIC",
        "REAL"
      ]
    },
    "files": {
      "description": "Every other file of the folder, sorted by path.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "description": "POSIX path relative to the folder or data root.",
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format": {
      "const": "av-analysis/exit-manifest"
    },
    "format_version": {
      "const": 1
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "station_id": {
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "visit_id": {
      "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}-D[07]|B-[PCS][0-9]{2}-M[12]-(V[1-3]|W[14]))$",
      "type": "string"
    }
  },
  "required": [
    "format",
    "format_version",
    "data_kind",
    "visit_id",
    "session_id",
    "station_id",
    "closed",
    "files"
  ],
  "title": "Exit manifest of a raw visit folder (raw/<visit_id>/exit-manifest.json)",
  "type": "object"
}
