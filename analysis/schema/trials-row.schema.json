{
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/analysis/schema/trials-row.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One row per trial-log row of a reconciled visit (every scheduled item and every linked retry), joined with the schedule's item and private intended tuple and with the cumulative exposure ledger. Holds the scoring inputs; scoring (Y, operational and valid-delivery) is #34's. No condition labels. Producer #33; consumers #34. Unique key: visit_id, trial_id. CSV encoding and masking rules: analysis/docs/architecture.md and docs/interfaces/analysis.md.",
  "properties": {
    "action_correct": {
      "description": "Logged action component score.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "actual_delay_hours": {
      "description": "Hours since the item's last lesson or test (logged).",
      "type": [
        "number",
        "null"
      ]
    },
    "audio_onset_estimate_mono_ms": {
      "description": "Actual or estimated audible onset (ms).",
      "type": [
        "integer",
        "null"
      ]
    },
    "block": {
      "description": "Schedule block.",
      "enum": [
        "profile_menu",
        "atom_menus",
        "atomic_lessons",
        "message_lessons",
        "pre_old",
        "trained",
        "novel",
        "atomic",
        "validity"
      ]
    },
    "block_position": {
      "description": "1-based block position in the visit.",
      "minimum": 1,
      "type": "integer"
    },
    "book_id": {
      "description": "Study A anonymous book ID from the learner-facing slot list (no method meaning); Study B bank ID. Methods are joined by #34 from the restricted key at unmasking.",
      "minLength": 1,
      "pattern": "^(BK-[PC]-[0-9A-Z]{6}|bank-[PC][0-9]{3}|DEMO-[A-Za-z0-9._-]{1,64})$",
      "type": "string"
    },
    "commit_mono_ms": {
      "description": "Commit time (ms).",
      "type": [
        "integer",
        "null"
      ]
    },
    "data_kind": {
      "description": "Watermark: SYNTHETIC or REAL, equal to the data root's.",
      "enum": [
        "SYNTHETIC",
        "REAL"
      ]
    },
    "days_since_anchor": {
      "description": "Calendar days from the anchor visit.",
      "type": [
        "integer",
        "null"
      ]
    },
    "deviation_ids": {
      "description": "Linked deviation IDs.",
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "discrepancy_codes": {
      "description": "Codes of discrepancies naming this row.",
      "items": {
        "enum": [
          "RAW_MANIFEST_MISSING",
          "RAW_FILE_MISSING",
          "RAW_FILE_UNLISTED",
          "RAW_HASH_CHANGED",
          "RAW_FORMAT",
          "REFERENCE_INPUT",
          "COUNT_MISSING_TRIAL",
          "COUNT_EXTRA_TRIAL",
          "COUNT_MISSING_PLAY",
          "COUNT_EXTRA_PLAY",
          "COUNT_RUN_SHEET",
          "BLOCK_ORDER",
          "WAVEFORM_HASH_MISMATCH",
          "PACKAGE_HASH_MISMATCH",
          "HOLDOUT_OUTSIDE_TEST",
          "HOLDOUT_WRONG_VISIT",
          "HOLDOUT_REPEAT_AS_NOVEL",
          "UNCERTAIN_NOT_CONSUMED",
          "RETRY_LINK_BROKEN",
          "ANSWER_DISPLAY_LEAK",
          "OLD_ATOM_CHANGED",
          "YOKED_SOURCE_MISSING",
          "YOKED_MISMATCH",
          "YOKED_GAP",
          "WINDOW_EARLY",
          "WINDOW_LATE",
          "VISIT_ORDER",
          "DEVIATION_MISSING",
          "DEVIATION_UNKNOWN"
        ]
      },
      "type": "array"
    },
    "exact_correct": {
      "description": "Logged exact score (null without a response window).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "exposure_consumed": {
      "description": "Reconciled: the cue was audible or its onset uncertain.",
      "type": "boolean"
    },
    "family": {
      "description": "Semantic family K or Q.",
      "enum": [
        "K",
        "Q",
        null
      ]
    },
    "item_id": {
      "description": "Message, atom or speech ID played (null: profile menu, no-cue).",
      "minLength": 1,
      "pattern": "^([KQ]-a[1-4]-r[1-4]|[KQ]-[ar][1-4]|[KQ]-[A-Z_]+-[A-H])$",
      "type": [
        "string",
        "null"
      ]
    },
    "item_kind": {
      "description": "Kind of item_id.",
      "enum": [
        "message",
        "atom",
        "speech",
        "none"
      ]
    },
    "novelty": {
      "description": "Held-out messages: first = this row is the person's first audible (or uncertain) exposure of the phrase; repeat = heard before. Null for other items.",
      "enum": [
        "first",
        "repeat",
        null
      ]
    },
    "onset_uncertainty_ms": {
      "description": "Onset uncertainty (ms).",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "pass": {
      "description": "Pass (repetition) 1 or 2.",
      "maximum": 2,
      "minimum": 1,
      "type": "integer"
    },
    "person_id": {
      "description": "Person slot (A-C07-L03, B-C12-M1). Coded participant IDs and the slot binding stay in the reveal log; no names or contact data anywhere.",
      "minLength": 1,
      "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}|B-[PCS][0-9]{2}-M[12])$",
      "type": "string"
    },
    "playback_status": {
      "description": "Observed delivery (vocab.PLAYBACK_STATUS).",
      "enum": [
        "played",
        "uncertain",
        "no_onset",
        "no_cue"
      ]
    },
    "position": {
      "description": "1-based item position in the block (a retry keeps its original's).",
      "minimum": 1,
      "type": "integer"
    },
    "prior_atom_exposures": {
      "description": "Audible or uncertain isolated plays of the item's component atoms before this row.",
      "minimum": 0,
      "type": "integer"
    },
    "prior_phrase_exposures": {
      "description": "Audible or uncertain plays of this complete message before this row.",
      "minimum": 0,
      "type": "integer"
    },
    "referent_correct": {
      "description": "Logged referent component score.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "response_action": {
      "description": "First committed action.",
      "enum": [
        "ADD_ONE",
        "REMOVE_ONE",
        "FLIP_CARD",
        "ALIGN_ARROW",
        "SCAN",
        "TAG",
        "CLOSE",
        "QUARANTINE",
        null
      ]
    },
    "response_code": {
      "description": "Logged response code (vocab.RESPONSE_CODES).",
      "enum": [
        "commit",
        "dont_know",
        "timeout",
        "none"
      ]
    },
    "response_target": {
      "description": "First committed target.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        null
      ]
    },
    "response_time_ms": {
      "description": "Logged commit minus onset (ms).",
      "type": [
        "integer",
        "null"
      ]
    },
    "retry_of": {
      "description": "trial_id this row retries (C4).",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "scheduled_onset_mono_ms": {
      "description": "Scheduled cue time (host monotonic ms).",
      "type": [
        "integer",
        "null"
      ]
    },
    "session_id": {
      "description": "Opaque session ID of the raw logs.",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "set": {
      "description": "Pilot or confirmatory set.",
      "enum": [
        "pilot",
        "confirmatory"
      ]
    },
    "study": {
      "description": "Study.",
      "enum": [
        "A",
        "B"
      ]
    },
    "target_action": {
      "description": "PRIVATE intended action label.",
      "enum": [
        "ADD_ONE",
        "REMOVE_ONE",
        "FLIP_CARD",
        "ALIGN_ARROW",
        "SCAN",
        "TAG",
        "CLOSE",
        "QUARANTINE",
        null
      ]
    },
    "target_referent": {
      "description": "PRIVATE intended referent label.",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        null
      ]
    },
    "technical_fault_code": {
      "description": "Apparatus fault, if any.",
      "enum": [
        "audio_underrun",
        "missing_playback",
        "hash_mismatch",
        "failed_reset",
        "missing_response_log",
        "presentation_freeze",
        null
      ]
    },
    "timing": {
      "description": "Visit timing against its window (windows.classify).",
      "enum": [
        "in_window",
        "early",
        "late",
        "not_applicable",
        "unknown"
      ]
    },
    "trained_status": {
      "description": "Matrix status of the cue (schedule trained_status).",
      "enum": [
        "trained",
        "heldout",
        "atom",
        "nonsemantic",
        "validity"
      ]
    },
    "trial_id": {
      "description": "Schedule trial ID, or the engine's ID of a retry.",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "trial_type": {
      "description": "Schedule trial type.",
      "enum": [
        "profile_menu",
        "atom_menu",
        "atomic_lesson",
        "message_lesson",
        "pre_old",
        "trained",
        "novel",
        "atomic",
        "no_cue",
        "speech"
      ]
    },
    "unit_id": {
      "description": "Study A matched batch or Study B dyad slot (A-C07, B-C12).",
      "minLength": 1,
      "pattern": "^(A-[PC][0-9]{2}|B-[PCS][0-9]{2})$",
      "type": "string"
    },
    "valid_delivery": {
      "description": "Verified playback (or a no-cue trial) and usable response logging, as reconciled against the exposure ledger (never inferred from a function returning success).",
      "type": "boolean"
    },
    "visit": {
      "description": "Visit (A D0, D7; B V1, V2, V3, W1, W4).",
      "enum": [
        "D0",
        "D7",
        "V1",
        "V2",
        "V3",
        "W1",
        "W4"
      ]
    },
    "visit_date": {
      "description": "Local study date of the visit (run sheet), when held.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": [
        "string",
        "null"
      ]
    },
    "visit_id": {
      "description": "<person_id>-<visit>, e.g. A-C07-L03-D0.",
      "minLength": 1,
      "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}-D[07]|B-[PCS][0-9]{2}-M[12]-(V[1-3]|W[14]))$",
      "type": "string"
    },
    "visit_seq": {
      "description": "1-based order of the visit within its study.",
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "data_kind",
    "study",
    "set",
    "unit_id",
    "book_id",
    "person_id",
    "visit",
    "visit_seq",
    "visit_id",
    "session_id",
    "trial_id",
    "retry_of",
    "block",
    "block_position",
    "position",
    "pass",
    "trial_type",
    "family",
    "item_id",
    "item_kind",
    "trained_status",
    "target_action",
    "target_referent",
    "response_code",
    "response_action",
    "response_target",
    "exact_correct",
    "action_correct",
    "referent_correct",
    "scheduled_onset_mono_ms",
    "audio_onset_estimate_mono_ms",
    "onset_uncertainty_ms",
    "commit_mono_ms",
    "response_time_ms",
    "playback_status",
    "technical_fault_code",
    "valid_delivery",
    "exposure_consumed",
    "novelty",
    "prior_phrase_exposures",
    "prior_atom_exposures",
    "actual_delay_hours",
    "visit_date",
    "days_since_anchor",
    "timing",
    "deviation_ids",
    "discrepancy_codes"
  ],
  "title": "Derived trial table row (derived/trials.csv)",
  "type": "object"
}
