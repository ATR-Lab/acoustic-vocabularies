{
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/analysis/schema/reconciliation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result of checks C1-C8 for one visit (#33). Deterministic: the same inputs give identical bytes (no run time, sorted inputs). Never contains accuracy, response, response-time, rating or condition fields (masking policy 'masked').",
  "properties": {
    "analyzer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "av-analysis"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "checks": {
      "description": "One entry per check, in order C1..C8.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7",
              "C8"
            ]
          },
          "discrepancies": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "enum": [
              "raw-integrity",
              "counts",
              "waveform-hashes",
              "exposure",
              "growth",
              "yoked-ledger",
              "windows",
              "deviation-links"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "explained",
              "fail",
              "not_applicable"
            ]
          },
          "unresolved": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "check",
          "name",
          "status",
          "discrepancies",
          "unresolved"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "data_kind": {
      "description": "Watermark (paths).",
      "enum": [
        "SYNTHETIC",
        "REAL"
      ]
    },
    "discrepancies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7",
              "C8"
            ]
          },
          "code": {
            "enum": [
              "RAW_MANIFEST_MISSING",
              "RAW_FILE_MISSING",
              "RAW_FILE_UNLISTED",
              "RAW_HASH_CHANGED",
              "RAW_FORMAT",
              "REFERENCE_INPUT",
              "COUNT_MISSING_TRIAL",
              "COUNT_EXTRA_TRIAL",
              "COUNT_MISSING_PLAY",
              "COUNT_EXTRA_PLAY",
              "COUNT_RUN_SHEET",
              "BLOCK_ORDER",
              "WAVEFORM_HASH_MISMATCH",
              "WAVEFORM_HASH_MISSING",
              "PACKAGE_HASH_MISMATCH",
              "HOLDOUT_OUTSIDE_TEST",
              "HOLDOUT_WRONG_VISIT",
              "HOLDOUT_REPEAT_AS_NOVEL",
              "UNCERTAIN_NOT_CONSUMED",
              "RETRY_LINK_BROKEN",
              "ANSWER_DISPLAY_LEAK",
              "OLD_ATOM_CHANGED",
              "STORE_CHAIN_BROKEN",
              "YOKED_SOURCE_MISSING",
              "YOKED_MISMATCH",
              "YOKED_GAP",
              "WINDOW_EARLY",
              "WINDOW_LATE",
              "VISIT_ORDER",
              "DEVIATION_MISSING",
              "DEVIATION_UNKNOWN"
            ]
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "deviation_id": {
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": [
              "string",
              "null"
            ]
          },
          "resolved": {
            "type": "boolean"
          },
          "rows": {
            "items": {
              "pattern": "^[^|]+$",
              "type": "string"
            },
            "type": "array"
          },
          "seq": {
            "minimum": 1,
            "type": "integer"
          },
          "suspension_event": {
            "enum": [
              "WRONG_FILE_MAPPING",
              "ANSWER_LEAK",
              "OLD_WAVEFORM_CHANGED",
              null
            ]
          }
        },
        "required": [
          "seq",
          "check",
          "code",
          "rows",
          "deviation_id",
          "resolved",
          "suspension_event",
          "detail"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format": {
      "const": "av-analysis/reconciliation"
    },
    "format_version": {
      "const": 1
    },
    "inputs": {
      "description": "Every file read (raw and reference), relative to the root.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "description": "POSIX path relative to the folder or data root.",
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "person_id": {
      "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}|B-[PCS][0-9]{2}-M[12])$",
      "type": "string"
    },
    "raw_unchanged": {
      "description": "Raw-file SHA-256 values identical before and after the run.",
      "type": "boolean"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "set": {
      "enum": [
        "pilot",
        "confirmatory"
      ]
    },
    "station_id": {
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "study": {
      "enum": [
        "A",
        "B"
      ]
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "discrepancies": {
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "suspension_events": {
          "items": {
            "enum": [
              "WRONG_FILE_MAPPING",
              "ANSWER_LEAK",
              "OLD_WAVEFORM_CHANGED"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "unresolved": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "discrepancies",
        "unresolved",
        "suspension_events"
      ],
      "type": "object"
    },
    "unit_id": {
      "pattern": "^(A-[PC][0-9]{2}|B-[PCS][0-9]{2})$",
      "type": "string"
    },
    "visit": {
      "enum": [
        "D0",
        "D7",
        "V1",
        "V2",
        "V3",
        "W1",
        "W4"
      ]
    },
    "visit_id": {
      "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}-D[07]|B-[PCS][0-9]{2}-M[12]-(V[1-3]|W[14]))$",
      "type": "string"
    }
  },
  "required": [
    "format",
    "format_version",
    "data_kind",
    "analyzer",
    "study",
    "set",
    "unit_id",
    "person_id",
    "visit",
    "visit_id",
    "session_id",
    "station_id",
    "inputs",
    "raw_unchanged",
    "checks",
    "discrepancies",
    "summary"
  ],
  "title": "Per-visit reconciliation report (reconciled/<visit_id>/reconciliation.json)",
  "type": "object"
}
