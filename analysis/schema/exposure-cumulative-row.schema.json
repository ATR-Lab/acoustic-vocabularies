{
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/analysis/schema/exposure-cumulative-row.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One row per person and item (atom or complete message) that was scheduled or played up to the last reconciled visit: first audible exposure and play counts by phase. Producer #33; consumers #34, #33. Unique key: person_id, item_id. CSV encoding and masking rules: analysis/docs/architecture.md and docs/interfaces/analysis.md.",
  "properties": {
    "audible_plays_n": {
      "description": "All plays that consumed exposure.",
      "minimum": 0,
      "type": "integer"
    },
    "data_kind": {
      "description": "Watermark: SYNTHETIC or REAL, equal to the data root's.",
      "enum": [
        "SYNTHETIC",
        "REAL"
      ]
    },
    "first_audible_block": {
      "description": "Block of that play.",
      "enum": [
        "profile_menu",
        "atom_menus",
        "atomic_lessons",
        "message_lessons",
        "pre_old",
        "trained",
        "novel",
        "atomic",
        "validity",
        null
      ]
    },
    "first_audible_event_id": {
      "description": "Exposure event of that play.",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "first_audible_status": {
      "description": "Its exposure-ledger audible_status (vocab.CONSUMING_AUDIBLE_STATUS).",
      "enum": [
        "confirmed_audible",
        "estimated",
        "uncertain",
        null
      ]
    },
    "first_audible_visit": {
      "description": "Visit of the first play that consumed exposure (audible, estimated or uncertain).",
      "enum": [
        "D0",
        "D7",
        "V1",
        "V2",
        "V3",
        "W1",
        "W4",
        null
      ]
    },
    "item_id": {
      "description": "Message or atom ID.",
      "minLength": 1,
      "pattern": "^([KQ]-a[1-4]-r[1-4]|[KQ]-[ar][1-4]|[KQ]-[A-Z_]+-[A-H])$",
      "type": "string"
    },
    "item_kind": {
      "description": "Kind of item.",
      "enum": [
        "message",
        "atom"
      ]
    },
    "last_visit": {
      "description": "Last reconciled visit included.",
      "enum": [
        "D0",
        "D7",
        "V1",
        "V2",
        "V3",
        "W1",
        "W4",
        null
      ]
    },
    "matrix_status": {
      "description": "Matrix status of the item.",
      "enum": [
        "trained",
        "heldout",
        "atom"
      ]
    },
    "person_id": {
      "description": "Person slot (A-C07-L03, B-C12-M1). Coded participant IDs and the slot binding stay in the reveal log; no names or contact data anywhere.",
      "minLength": 1,
      "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}|B-[PCS][0-9]{2}-M[12])$",
      "type": "string"
    },
    "scheduled_novel_visit": {
      "description": "Held-out: visit of its novel test.",
      "enum": [
        "D0",
        "D7",
        "V1",
        "V2",
        "V3",
        "W1",
        "W4",
        null
      ]
    },
    "selection_plays_n": {
      "description": "Plays in profile or atom menus.",
      "minimum": 0,
      "type": "integer"
    },
    "set": {
      "description": "Pilot or confirmatory set.",
      "enum": [
        "pilot",
        "confirmatory"
      ]
    },
    "study": {
      "description": "Study.",
      "enum": [
        "A",
        "B"
      ]
    },
    "teaching_plays_n": {
      "description": "Plays in lessons.",
      "minimum": 0,
      "type": "integer"
    },
    "test_plays_n": {
      "description": "Plays in pre-old, protected and validity blocks.",
      "minimum": 0,
      "type": "integer"
    },
    "unit_id": {
      "description": "Study A matched batch or Study B dyad slot (A-C07, B-C12).",
      "minLength": 1,
      "pattern": "^(A-[PC][0-9]{2}|B-[PCS][0-9]{2})$",
      "type": "string"
    },
    "violations": {
      "description": "C4 codes raised for this item.",
      "items": {
        "enum": [
          "RAW_MANIFEST_MISSING",
          "RAW_FILE_MISSING",
          "RAW_FILE_UNLISTED",
          "RAW_HASH_CHANGED",
          "RAW_FORMAT",
          "REFERENCE_INPUT",
          "COUNT_MISSING_TRIAL",
          "COUNT_EXTRA_TRIAL",
          "COUNT_MISSING_PLAY",
          "COUNT_EXTRA_PLAY",
          "COUNT_RUN_SHEET",
          "BLOCK_ORDER",
          "WAVEFORM_HASH_MISMATCH",
          "WAVEFORM_HASH_MISSING",
          "PACKAGE_HASH_MISMATCH",
          "HOLDOUT_OUTSIDE_TEST",
          "HOLDOUT_WRONG_VISIT",
          "HOLDOUT_REPEAT_AS_NOVEL",
          "UNCERTAIN_NOT_CONSUMED",
          "RETRY_LINK_BROKEN",
          "ANSWER_DISPLAY_LEAK",
          "OLD_ATOM_CHANGED",
          "STORE_CHAIN_BROKEN",
          "YOKED_SOURCE_MISSING",
          "YOKED_MISMATCH",
          "YOKED_GAP",
          "WINDOW_EARLY",
          "WINDOW_LATE",
          "VISIT_ORDER",
          "DEVIATION_MISSING",
          "DEVIATION_UNKNOWN"
        ]
      },
      "type": "array"
    }
  },
  "required": [
    "data_kind",
    "study",
    "set",
    "unit_id",
    "person_id",
    "item_id",
    "item_kind",
    "matrix_status",
    "scheduled_novel_visit",
    "first_audible_visit",
    "first_audible_event_id",
    "first_audible_status",
    "first_audible_block",
    "audible_plays_n",
    "selection_plays_n",
    "teaching_plays_n",
    "test_plays_n",
    "last_visit",
    "violations"
  ],
  "title": "Cumulative per-person exposure ledger row (reconciled/exposure-cumulative.csv)",
  "type": "object"
}
