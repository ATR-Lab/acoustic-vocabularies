{
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/analysis/schema/discrepancies-row.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every discrepancy of every reconciliation report, in report order. Details name rows and rules, never scores, responses or conditions. Producer #33; consumers #35, #34. Unique key: visit_id, seq. CSV encoding and masking rules: analysis/docs/architecture.md and docs/interfaces/analysis.md.",
  "properties": {
    "check": {
      "description": "Check that found it.",
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C8"
      ]
    },
    "code": {
      "description": "Discrepancy code (codes.CODES).",
      "enum": [
        "RAW_MANIFEST_MISSING",
        "RAW_FILE_MISSING",
        "RAW_FILE_UNLISTED",
        "RAW_HASH_CHANGED",
        "RAW_FORMAT",
        "REFERENCE_INPUT",
        "COUNT_MISSING_TRIAL",
        "COUNT_EXTRA_TRIAL",
        "COUNT_MISSING_PLAY",
        "COUNT_EXTRA_PLAY",
        "COUNT_RUN_SHEET",
        "BLOCK_ORDER",
        "WAVEFORM_HASH_MISMATCH",
        "WAVEFORM_HASH_MISSING",
        "PACKAGE_HASH_MISMATCH",
        "HOLDOUT_OUTSIDE_TEST",
        "HOLDOUT_WRONG_VISIT",
        "HOLDOUT_REPEAT_AS_NOVEL",
        "UNCERTAIN_NOT_CONSUMED",
        "RETRY_LINK_BROKEN",
        "ANSWER_DISPLAY_LEAK",
        "OLD_ATOM_CHANGED",
        "STORE_CHAIN_BROKEN",
        "YOKED_SOURCE_MISSING",
        "YOKED_MISMATCH",
        "YOKED_GAP",
        "WINDOW_EARLY",
        "WINDOW_LATE",
        "VISIT_ORDER",
        "DEVIATION_MISSING",
        "DEVIATION_UNKNOWN",
        "RESPONSE_EVENT_MISSING",
        "TECHNICAL_FLAG_MISSING",
        "PLAYBACK_STATUS_CONFLICT"
      ]
    },
    "data_kind": {
      "description": "Watermark: SYNTHETIC or REAL, equal to the data root's.",
      "enum": [
        "SYNTHETIC",
        "REAL"
      ]
    },
    "detail": {
      "description": "Generated explanation (no outcome values).",
      "minLength": 1,
      "type": "string"
    },
    "deviation_id": {
      "description": "Linked deviation record.",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "person_id": {
      "description": "Person slot (A-C07-L03, B-C12-M1). Coded participant IDs and the slot binding stay in the reveal log; no names or contact data anywhere.",
      "minLength": 1,
      "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}|B-[PCS][0-9]{2}-M[12])$",
      "type": "string"
    },
    "resolved": {
      "description": "Linked to an existing deviation record.",
      "type": "boolean"
    },
    "rows": {
      "description": "trial_id, event_id or file names involved.",
      "items": {
        "minLength": 1,
        "pattern": "^[^|]+$",
        "type": "string"
      },
      "type": "array"
    },
    "seq": {
      "description": "1-based order in the visit's report.",
      "minimum": 1,
      "type": "integer"
    },
    "study": {
      "description": "Study.",
      "enum": [
        "A",
        "B"
      ]
    },
    "suspension_event": {
      "description": "Suspension event of the code.",
      "enum": [
        "WRONG_FILE_MAPPING",
        "ANSWER_LEAK",
        "OLD_WAVEFORM_CHANGED",
        null
      ]
    },
    "unit_id": {
      "description": "Study A matched batch or Study B dyad slot (A-C07, B-C12).",
      "minLength": 1,
      "pattern": "^(A-[PC][0-9]{2}|B-[PCS][0-9]{2})$",
      "type": "string"
    },
    "visit": {
      "description": "Visit (A D0, D7; B V1, V2, V3, W1, W4).",
      "enum": [
        "D0",
        "D7",
        "V1",
        "V2",
        "V3",
        "W1",
        "W4"
      ]
    },
    "visit_id": {
      "description": "<person_id>-<visit>, e.g. A-C07-L03-D0.",
      "minLength": 1,
      "pattern": "^(A-[PC][0-9]{2}-L[0-9]{2}-D[07]|B-[PCS][0-9]{2}-M[12]-(V[1-3]|W[14]))$",
      "type": "string"
    },
    "visit_seq": {
      "description": "1-based order of the visit within its study.",
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "data_kind",
    "study",
    "unit_id",
    "person_id",
    "visit",
    "visit_seq",
    "visit_id",
    "seq",
    "check",
    "code",
    "rows",
    "deviation_id",
    "resolved",
    "suspension_event",
    "detail"
  ],
  "title": "Discrepancies row (reconciled/discrepancies.csv)",
  "type": "object"
}
