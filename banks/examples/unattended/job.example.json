{
  "format": "av-banks/unattended-job",
  "format_version": 1,
  "job_id": "closure-banks-01",
  "root": "<restricted>/closure-banks-01/job",
  "heartbeat_s": 60,
  "lock_wait_s": 86400,
  "model": {
    "url": "http://<llm-host>:8000",
    "runtime": "vllm",
    "max_wait_s": 43200,
    "poll_initial_s": 5,
    "poll_max_s": 120,
    "probe_timeout_s": 10
  },
  "stages": [
    {
      "name": "pilot",
      "kind": "pilot",
      "run_id": "P-banks-01",
      "units": "<restricted>/schedules-out/B-pilot",
      "generation_config": "<restricted>/pilot/generation-config.json",
      "meanings": "<restricted>/meanings",
      "prompts": "<restricted>/prompts",
      "decoding_schema": "<restricted>/decoding-schema.json",
      "dyads": 8,
      "spares": 2,
      "workers": 3,
      "parallel_banks": 2,
      "breaker": 3,
      "max_restarts": 2,
      "on_shortfall": "stop"
    },
    {
      "name": "confirmatory",
      "kind": "confirmatory",
      "plan": {
        "campaign_id": "C-banks-v1",
        "generation_config": "<restricted>/confirmatory/generation-config.json",
        "freeze_manifest": "<checkout>/generation/FREEZE-v1.0.json",
        "repo": "<checkout>",
        "units": "<restricted>/schedules-out/B",
        "pilot_stages": ["pilot"],
        "parallel_banks": 6
      },
      "meanings": "<restricted>/meanings",
      "prompts": "<restricted>/prompts",
      "decoding_schema": "<restricted>/decoding-schema.json",
      "parallel_banks": 6,
      "workers": 3,
      "breaker": 3,
      "monitor_interval_s": 60,
      "verify_jobs": 8,
      "max_rebuilds_per_bank": 2,
      "register": true
    }
  ]
}
