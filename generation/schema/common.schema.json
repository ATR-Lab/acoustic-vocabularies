{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/blob/main/generation/schema/common.schema.json",
  "title": "Shared definitions of the generation schemas",
  "description": "Definitions referenced by the other generation schemas (no instance uses this schema directly). IDs: generation/src/av_generation/ids.py; seeds: seeds.py; outcomes: outcomes.py.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "description": "Batch, bank or run ID: 3-64 ASCII letters, digits and inner hyphens.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,62}[A-Za-z0-9]$"
    },
    "book_id": {
      "description": "Anonymous book ID (store rules; av_sound.store.check_book_id).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,62}[A-Za-z0-9]$"
    },
    "atom_id": {
      "type": "string",
      "pattern": "^[KQ]-[ar][1-4]$"
    },
    "profile": {
      "enum": [
        "P1",
        "P2",
        "P3"
      ]
    },
    "study": {
      "enum": [
        "A",
        "B"
      ]
    },
    "method": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "B"
      ]
    },
    "study_a_method": {
      "enum": [
        "A1",
        "A2",
        "A3"
      ]
    },
    "run_kind": {
      "enum": [
        "demo",
        "synthetic",
        "practice",
        "pilot",
        "confirmatory"
      ]
    },
    "proposal_slot_id": {
      "description": "Study A proposal slot: <book>.<atom>.r<round>s<slot>.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,62}[A-Za-z0-9]\\.[KQ]-[ar][1-4]\\.r[1-4]s[1-3]$"
    },
    "bank_slot_id": {
      "description": "Study B proposal slot: <bank>.t<attempt>.<profile>.<atom>.s<slot:02>.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,62}[A-Za-z0-9]\\.t[1-4]\\.P[1-3]\\.[KQ]-[ar][1-4]\\.s(0[1-9]|1[0-2])$"
    },
    "slot_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/proposal_slot_id"
        },
        {
          "$ref": "#/$defs/bank_slot_id"
        }
      ]
    },
    "rating_slot_id": {
      "description": "Rating slot: <batch>.<atom>.r<round>p<position>.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,62}[A-Za-z0-9]\\.[KQ]-[ar][1-4]\\.r[1-4]p[1-9]$"
    },
    "seed_key": {
      "description": "Seed key (av_generation.seeds): namespace|part|...",
      "type": "string",
      "pattern": "^(A1|A2|A3|B|PANEL|BOT|THRESHOLD)(\\|[A-Za-z0-9._-]+)+$"
    },
    "seed": {
      "description": "Unsigned 64-bit seed: first 8 bytes of SHA-256(seed key), big-endian.",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "wire_seed": {
      "description": "Signed 64-bit two's-complement reading of the seed (sent to the server).",
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "t_ms": {
      "description": "Run-clock milliseconds (monotonic).",
      "type": "integer",
      "minimum": 0
    },
    "utc": {
      "description": "UTC time, ISO 8601 with milliseconds and Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "decimal": {
      "description": "Finite decimal text, e.g. 0.10.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "fraction": {
      "description": "Exact non-negative rational p/q or integer text.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"
    },
    "coded_id": {
      "description": "Coded person or station ID (no names).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
    },
    "station": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}$"
    },
    "semantic_label": {
      "enum": [
        "ADD_ONE",
        "REMOVE_ONE",
        "FLIP_CARD",
        "ALIGN_ARROW",
        "A",
        "B",
        "C",
        "D",
        "SCAN",
        "TAG",
        "CLOSE",
        "QUARANTINE",
        "E",
        "F",
        "G",
        "H"
      ]
    },
    "outcome": {
      "enum": [
        "valid",
        "invalid_json",
        "schema_violation",
        "out_of_domain",
        "render_fail",
        "event_too_short",
        "clipping",
        "duplicate",
        "reserved_collision",
        "separation_fail",
        "incompatible",
        "overflow_input",
        "overflow_output",
        "timeout"
      ]
    },
    "validator_code": {
      "enum": [
        "E_JSON",
        "E_SCHEMA",
        "E_DOMAIN",
        "E_EVENT_SHORT",
        "E_NONFINITE",
        "E_CLIP",
        "E_DUPLICATE",
        "E_RESERVED",
        "E_SEPARATION"
      ]
    },
    "llm_status": {
      "enum": [
        "ok",
        "timeout",
        "overflow_output",
        "server_error"
      ]
    },
    "recipe": {
      "$ref": "https://github.com/ATR-Lab/acoustic-vocabularies/blob/main/sound/schema/recipe.schema.json"
    },
    "value": {
      "description": "A recipe coordinate value.",
      "type": "number"
    },
    "coordinate": {
      "enum": [
        "pitch_1",
        "pitch_2",
        "pitch_3",
        "total_ms",
        "rhythm_weight_1",
        "rhythm_weight_2",
        "rhythm_weight_3",
        "gap_1",
        "gap_2",
        "amplitude_1",
        "amplitude_2",
        "amplitude_3"
      ]
    },
    "text": {
      "description": "Printable ASCII, at most 400 characters.",
      "type": "string",
      "pattern": "^[ -~]{0,400}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "panel_alias": {
      "description": "Per-panel book alias shown on the operator console (av_generation.ids.PANEL_ALIAS_RE).",
      "type": "string",
      "pattern": "^PB-[BCFGHJKMNPQRTVWXY456789]{4}$"
    },
    "meaning_text": {
      "description": "A meaning text shown to raters, designers and the model: printable ASCII, 1-200 characters.",
      "type": "string",
      "pattern": "^[ -~]{1,200}$"
    },
    "seed_part": {
      "description": "One part of a seed key (av_generation.seeds.PART_RE).",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
