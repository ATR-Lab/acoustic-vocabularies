{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/blob/main/generation/schema/audit-summary.schema.json",
  "title": "Generation audit summary",
  "description": "summary.json of a generation audit (#24): one entry per book with the columns of books.csv (av_generation.audit.BOOK_COLUMNS), the batch timing, the audit checks and the sources read. masked true: no column that names or reveals a method by construction may appear (av_generation.audit.METHOD_COLUMNS: method, designer, per-method effort, every outcome count, startup and operator time) and machines is null; masked false: they are required. sources maps each file read (run manifest, batch config, logs, machine specifications) to its SHA-256. Times are run-clock milliseconds; wall times are sums of paired start/end timing events. Definitions: generation/docs/audit.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "books",
    "checks",
    "format",
    "format_version",
    "machines",
    "masked",
    "run_id",
    "sources",
    "timing"
  ],
  "properties": {
    "format": {
      "const": "av-generation/audit-summary"
    },
    "format_version": {
      "const": 1
    },
    "masked": {
      "type": "boolean"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "batch_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._/-]{1,256}$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atoms_bank_fallback",
          "atoms_book_fallback",
          "atoms_committed",
          "atoms_selector",
          "batch_id",
          "book_id",
          "candidate_diversity",
          "committed_diversity",
          "failed_generation",
          "message_duration_violations",
          "message_ms_max",
          "message_ms_min",
          "nonfallback",
          "profile",
          "rater_ms",
          "slots_invalid",
          "slots_total",
          "slots_valid",
          "total_ms_450",
          "total_ms_600",
          "total_ms_750",
          "total_ms_900",
          "wall_ms"
        ],
        "properties": {
          "batch_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "book_id": {
            "$ref": "common.schema.json#/$defs/book_id"
          },
          "method": {
            "$ref": "common.schema.json#/$defs/study_a_method"
          },
          "designer_id": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/coded_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile": {
            "$ref": "common.schema.json#/$defs/profile"
          },
          "slots_total": {
            "type": "integer",
            "minimum": 0
          },
          "slots_valid": {
            "type": "integer",
            "minimum": 0
          },
          "slots_invalid": {
            "type": "integer",
            "minimum": 0
          },
          "n_valid": {
            "type": "integer",
            "minimum": 0
          },
          "n_invalid_json": {
            "type": "integer",
            "minimum": 0
          },
          "n_schema_violation": {
            "type": "integer",
            "minimum": 0
          },
          "n_out_of_domain": {
            "type": "integer",
            "minimum": 0
          },
          "n_render_fail": {
            "type": "integer",
            "minimum": 0
          },
          "n_event_too_short": {
            "type": "integer",
            "minimum": 0
          },
          "n_clipping": {
            "type": "integer",
            "minimum": 0
          },
          "n_duplicate": {
            "type": "integer",
            "minimum": 0
          },
          "n_reserved_collision": {
            "type": "integer",
            "minimum": 0
          },
          "n_separation_fail": {
            "type": "integer",
            "minimum": 0
          },
          "n_incompatible": {
            "type": "integer",
            "minimum": 0
          },
          "n_overflow_input": {
            "type": "integer",
            "minimum": 0
          },
          "n_overflow_output": {
            "type": "integer",
            "minimum": 0
          },
          "n_timeout": {
            "type": "integer",
            "minimum": 0
          },
          "atoms_committed": {
            "type": "integer",
            "minimum": 0
          },
          "atoms_selector": {
            "type": "integer",
            "minimum": 0
          },
          "atoms_bank_fallback": {
            "type": "integer",
            "minimum": 0
          },
          "atoms_book_fallback": {
            "type": "integer",
            "minimum": 0
          },
          "failed_generation": {
            "type": "boolean"
          },
          "nonfallback": {
            "type": "boolean"
          },
          "wall_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "startup_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "operator_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "rater_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "design_active_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "familiarization_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "model_runtime_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "tokens_in": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "tokens_out": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_diversity": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "committed_diversity": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "total_ms_450": {
            "type": "integer",
            "minimum": 0
          },
          "total_ms_600": {
            "type": "integer",
            "minimum": 0
          },
          "total_ms_750": {
            "type": "integer",
            "minimum": 0
          },
          "total_ms_900": {
            "type": "integer",
            "minimum": 0
          },
          "message_ms_min": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "message_ms_max": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "message_duration_violations": {
            "type": "integer",
            "minimum": 0
          },
          "n_llm_server_error": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appointments",
        "atoms",
        "batch_wall_ms",
        "max_appointment_ms",
        "max_atom_ms",
        "operator_ms",
        "startup_ms"
      ],
      "properties": {
        "batch_wall_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "appointments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "appointment",
              "wall_ms"
            ],
            "properties": {
              "appointment": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "wall_ms": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 4
        },
        "atoms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "appointment",
              "atom_id",
              "max_round_ms",
              "position",
              "rounds_ms",
              "wall_ms"
            ],
            "properties": {
              "atom_id": {
                "$ref": "common.schema.json#/$defs/atom_id"
              },
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "appointment": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "wall_ms": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rounds_ms": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "max_round_ms": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 16
        },
        "max_atom_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_appointment_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "startup_ms": {
          "description": "Every paired startup interval of the batch (all components).",
          "type": "integer",
          "minimum": 0
        },
        "operator_ms": {
          "description": "Sum of duration_ms of every operator_action event of the batch.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "fallback_scans",
        "notes",
        "ok",
        "problems",
        "slot_refusals"
      ],
      "properties": {
        "complete": {
          "description": "The run manifest is closed and no batch_incomplete event was logged.",
          "type": "boolean"
        },
        "ok": {
          "description": "No problem found (problems is empty).",
          "type": "boolean"
        },
        "problems": {
          "description": "Sorted descriptions of every count or link that failed a check. Masked: method-neutral texts (no startup component, designer or practice mode); unmasked: the full detail.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "description": "Sorted informational notes that are not check failures, e.g. an atom, round or appointment interrupted by a restart (counted until the last event logged before it, and from the restart on).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "slot_refusals": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_scans": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "machines": {
      "description": "Machine specifications by role (e.g. llm_host, a1_station), copied from the apparatus manifest; unmasked only.",
      "oneOf": [
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9_]{1,64}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "masked": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "books": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "design_active_ms"
                    ]
                  },
                  {
                    "required": [
                      "designer_id"
                    ]
                  },
                  {
                    "required": [
                      "familiarization_ms"
                    ]
                  },
                  {
                    "required": [
                      "method"
                    ]
                  },
                  {
                    "required": [
                      "model_runtime_ms"
                    ]
                  },
                  {
                    "required": [
                      "n_clipping"
                    ]
                  },
                  {
                    "required": [
                      "n_duplicate"
                    ]
                  },
                  {
                    "required": [
                      "n_event_too_short"
                    ]
                  },
                  {
                    "required": [
                      "n_incompatible"
                    ]
                  },
                  {
                    "required": [
                      "n_invalid_json"
                    ]
                  },
                  {
                    "required": [
                      "n_llm_server_error"
                    ]
                  },
                  {
                    "required": [
                      "n_out_of_domain"
                    ]
                  },
                  {
                    "required": [
                      "n_overflow_input"
                    ]
                  },
                  {
                    "required": [
                      "n_overflow_output"
                    ]
                  },
                  {
                    "required": [
                      "n_render_fail"
                    ]
                  },
                  {
                    "required": [
                      "n_reserved_collision"
                    ]
                  },
                  {
                    "required": [
                      "n_schema_violation"
                    ]
                  },
                  {
                    "required": [
                      "n_separation_fail"
                    ]
                  },
                  {
                    "required": [
                      "n_timeout"
                    ]
                  },
                  {
                    "required": [
                      "n_valid"
                    ]
                  },
                  {
                    "required": [
                      "operator_ms"
                    ]
                  },
                  {
                    "required": [
                      "startup_ms"
                    ]
                  },
                  {
                    "required": [
                      "tokens_in"
                    ]
                  },
                  {
                    "required": [
                      "tokens_out"
                    ]
                  }
                ]
              }
            }
          },
          "machines": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "books": {
            "items": {
              "required": [
                "design_active_ms",
                "designer_id",
                "familiarization_ms",
                "method",
                "model_runtime_ms",
                "n_clipping",
                "n_duplicate",
                "n_event_too_short",
                "n_incompatible",
                "n_invalid_json",
                "n_llm_server_error",
                "n_out_of_domain",
                "n_overflow_input",
                "n_overflow_output",
                "n_render_fail",
                "n_reserved_collision",
                "n_schema_violation",
                "n_separation_fail",
                "n_timeout",
                "n_valid",
                "operator_ms",
                "startup_ms",
                "tokens_in",
                "tokens_out"
              ]
            }
          }
        }
      }
    }
  ]
}
