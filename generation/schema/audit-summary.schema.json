{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ATR-Lab/acoustic-vocabularies/blob/main/generation/schema/audit-summary.schema.json",
  "title": "Generation audit summary",
  "description": "summary.json of a generation audit (#24): one entry per book with the columns of books.csv (av_generation.audit.BOOK_COLUMNS) and the batch timing. masked true: no method-revealing field may appear (av_generation.audit.METHOD_COLUMNS); masked false: they are required. sources maps each log file read to its SHA-256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "books",
    "format",
    "format_version",
    "masked",
    "run_id",
    "sources",
    "timing"
  ],
  "properties": {
    "format": {
      "const": "av-generation/audit-summary"
    },
    "format_version": {
      "const": 1
    },
    "masked": {
      "type": "boolean"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "batch_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._/-]{1,256}$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atoms_bank_fallback",
          "atoms_book_fallback",
          "atoms_committed",
          "atoms_selector",
          "batch_id",
          "book_id",
          "candidate_diversity",
          "committed_diversity",
          "failed_generation",
          "message_duration_violations",
          "message_ms_max",
          "message_ms_min",
          "n_clipping",
          "n_duplicate",
          "n_event_too_short",
          "n_incompatible",
          "n_invalid_json",
          "n_out_of_domain",
          "n_overflow_input",
          "n_overflow_output",
          "n_render_fail",
          "n_reserved_collision",
          "n_schema_violation",
          "n_separation_fail",
          "n_timeout",
          "n_valid",
          "nonfallback",
          "operator_ms",
          "profile",
          "rater_ms",
          "slots_invalid",
          "slots_total",
          "slots_valid",
          "startup_ms",
          "total_ms_450",
          "total_ms_600",
          "total_ms_750",
          "total_ms_900",
          "wall_ms"
        ],
        "properties": {
          "batch_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "book_id": {
            "$ref": "common.schema.json#/$defs/book_id"
          },
          "method": {
            "$ref": "common.schema.json#/$defs/study_a_method"
          },
          "designer_id": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/coded_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile": {
            "$ref": "common.schema.json#/$defs/profile"
          },
          "slots_total": {
            "type": "integer",
            "minimum": 0
          },
          "slots_valid": {
            "type": "integer",
            "minimum": 0
          },
          "slots_invalid": {
            "type": "integer",
            "minimum": 0
          },
          "n_valid": {
            "type": "integer",
            "minimum": 0
          },
          "n_invalid_json": {
            "type": "integer",
            "minimum": 0
          },
          "n_schema_violation": {
            "type": "integer",
            "minimum": 0
          },
          "n_out_of_domain": {
            "type": "integer",
            "minimum": 0
          },
          "n_render_fail": {
            "type": "integer",
            "minimum": 0
          },
          "n_event_too_short": {
            "type": "integer",
            "minimum": 0
          },
          "n_clipping": {
            "type": "integer",
            "minimum": 0
          },
          "n_duplicate": {
            "type": "integer",
            "minimum": 0
          },
          "n_reserved_collision": {
            "type": "integer",
            "minimum": 0
          },
          "n_separation_fail": {
            "type": "integer",
            "minimum": 0
          },
          "n_incompatible": {
            "type": "integer",
            "minimum": 0
          },
          "n_overflow_input": {
            "type": "integer",
            "minimum": 0
          },
          "n_overflow_output": {
            "type": "integer",
            "minimum": 0
          },
          "n_timeout": {
            "type": "integer",
            "minimum": 0
          },
          "atoms_committed": {
            "type": "integer",
            "minimum": 0
          },
          "atoms_selector": {
            "type": "integer",
            "minimum": 0
          },
          "atoms_bank_fallback": {
            "type": "integer",
            "minimum": 0
          },
          "atoms_book_fallback": {
            "type": "integer",
            "minimum": 0
          },
          "failed_generation": {
            "type": "boolean"
          },
          "nonfallback": {
            "type": "boolean"
          },
          "wall_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "startup_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "operator_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "rater_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "design_active_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "familiarization_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "model_runtime_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "tokens_in": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "tokens_out": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_diversity": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "committed_diversity": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "total_ms_450": {
            "type": "integer",
            "minimum": 0
          },
          "total_ms_600": {
            "type": "integer",
            "minimum": 0
          },
          "total_ms_750": {
            "type": "integer",
            "minimum": 0
          },
          "total_ms_900": {
            "type": "integer",
            "minimum": 0
          },
          "message_ms_min": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "message_ms_max": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "message_duration_violations": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appointments",
        "atoms",
        "batch_wall_ms",
        "max_appointment_ms",
        "max_atom_ms"
      ],
      "properties": {
        "batch_wall_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "appointments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "appointment",
              "wall_ms"
            ],
            "properties": {
              "appointment": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "wall_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "atoms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atom_id",
              "max_round_ms",
              "wall_ms"
            ],
            "properties": {
              "atom_id": {
                "$ref": "common.schema.json#/$defs/atom_id"
              },
              "wall_ms": {
                "type": "integer",
                "minimum": 0
              },
              "max_round_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "max_atom_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_appointment_ms": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "masked": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "books": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "method"
                    ]
                  },
                  {
                    "required": [
                      "designer_id"
                    ]
                  },
                  {
                    "required": [
                      "design_active_ms"
                    ]
                  },
                  {
                    "required": [
                      "familiarization_ms"
                    ]
                  },
                  {
                    "required": [
                      "model_runtime_ms"
                    ]
                  },
                  {
                    "required": [
                      "tokens_in"
                    ]
                  },
                  {
                    "required": [
                      "tokens_out"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "books": {
            "items": {
              "required": [
                "method",
                "designer_id",
                "design_active_ms",
                "familiarization_ms",
                "model_runtime_ms",
                "tokens_in",
                "tokens_out"
              ]
            }
          }
        }
      }
    }
  ]
}
