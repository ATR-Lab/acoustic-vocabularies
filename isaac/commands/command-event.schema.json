{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "apparatus_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "clock_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "private_command_result"
    },
    "event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "host_mono_ms": {
      "type": "number",
      "minimum": 0
    },
    "sim_time": {
      "type": "number",
      "minimum": 0
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "station_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "teaching",
            "test",
            "post_endpoint"
          ]
        },
        "client": {
          "type": "string"
        },
        "raw_command": {
          "type": "string"
        },
        "command": {},
        "arguments": {},
        "reply": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "kind": {
              "const": "private_reply"
            },
            "request_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "accepted": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "enum": [
                "teaching",
                "test",
                "post_endpoint"
              ]
            },
            "host_mono_ms": {
              "type": "number",
              "minimum": 0
            },
            "sim_time": {
              "type": "number",
              "minimum": 0
            },
            "reset_ok": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "duplicate": {
              "type": "boolean"
            },
            "health": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "control_session_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "mode": {
                  "enum": [
                    "teaching",
                    "test",
                    "post_endpoint"
                  ]
                },
                "paused": {
                  "type": "boolean"
                },
                "stopped": {
                  "type": "boolean"
                },
                "fault": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "demo_active": {
                  "type": "boolean"
                },
                "publisher_ready": {
                  "type": "boolean"
                },
                "exposure_ready": {
                  "type": "boolean"
                },
                "public_stream_recovered": {
                  "const": false
                }
              },
              "required": [
                "control_session_id",
                "mode",
                "paused",
                "stopped",
                "fault",
                "demo_active",
                "publisher_ready",
                "exposure_ready",
                "public_stream_recovered"
              ]
            }
          },
          "required": [
            "version",
            "kind",
            "request_id",
            "accepted",
            "reason",
            "mode",
            "host_mono_ms",
            "sim_time",
            "reset_ok",
            "duplicate",
            "health"
          ],
          "$schema": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "required": [
        "station_id",
        "mode",
        "client",
        "raw_command",
        "command",
        "arguments",
        "reply"
      ]
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "apparatus_version",
    "protocol_version",
    "clock_id",
    "event_type",
    "event_seq",
    "host_mono_ms",
    "sim_time",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Engineering ADR-007 private command extension; command/arguments intentionally retain malformed decoded values, and raw_command preserves the complete text."
}
